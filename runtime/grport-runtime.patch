+// The game's save data list: its saves (title, details, time) and "New save"; the selection
+// moves with the keyboard, the controller or the mouse.
+void SaveListBox() {
+    const ImGuiViewport* viewport = ImGui::GetMainViewport();
+    const float width = viewport->WorkSize.x * 0.46f;
+    ImGui::SetNextWindowPos(ImVec2(viewport->WorkPos.x + viewport->WorkSize.x * 0.5f,
+                                   viewport->WorkPos.y + viewport->WorkSize.y * 0.5f),
+                            ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSizeConstraints(ImVec2(width, 0.0f), ImVec2(width, FLT_MAX));
+    ImGui::SetNextWindowBgAlpha(0.94f);
+    ImGui::Begin("##save_list", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoNav |
+                     ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoSavedSettings);
+    ImGui::SetWindowFontScale(1.3f);
+    ImGui::TextColored(ImVec4(0.85f, 0.72f, 0.45f, 1.0f), "%s", save_heading.c_str());
+    ImGui::SetWindowFontScale(1.0f);
+    ImGui::Separator();
+
+    const float line = ImGui::GetTextLineHeightWithSpacing();
+    const float pad = 6.0f * base_scale;
+    // Sized to the rows drawn last frame (an estimate on the first), at most 55% of the screen.
+    float rows_height = float(save_entries.size()) * (line * 4.5f + pad * 2.0f);
+    if (save_rows.size() == save_entries.size() && !save_rows.empty() && save_rows.back().w > 0.0f) {
+        rows_height = save_rows.back().w - save_rows.front().y + ImGui::GetStyle().WindowPadding.y * 2.0f;
+    }
+    const float list_height = std::min(rows_height, viewport->WorkSize.y * 0.55f);
+    ImGui::BeginChild("##saves", ImVec2(0.0f, list_height), ImGuiChildFlags_None,
+                      ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoNav);
+    const ImVec2 clip_min = ImGui::GetWindowPos();
+    const ImVec2 clip_max(clip_min.x + ImGui::GetWindowWidth(),
+                          clip_min.y + ImGui::GetWindowHeight());
+    save_clip = ImVec4(clip_min.x, clip_min.y, clip_max.x, clip_max.y);
+    save_rows.assign(save_entries.size(), ImVec4());
+    ImDrawList* draw = ImGui::GetWindowDrawList();
+    for (size_t i = 0; i < save_entries.size(); ++i) {
+        const SaveEntry& entry = save_entries[i];
+        const bool selected = int(i) == save_selected;
+        if (selected && save_scroll) {
+            ImGui::SetScrollHereY(0.5f);
+            save_scroll = false;
+        }
+        const ImVec2 top = ImGui::GetCursorScreenPos();
+        const float row_width = ImGui::GetContentRegionAvail().x;
+        draw->ChannelsSplit(2);
+        draw->ChannelsSetCurrent(1);
+        ImGui::BeginGroup();
+        ImGui::Dummy(ImVec2(row_width, pad));
+        ImGui::Indent(pad * 2.0f);
+        ImGui::SetWindowFontScale(1.2f);
+        if (entry.dir.empty()) {
+            ImGui::TextColored(ImVec4(0.85f, 0.72f, 0.45f, 1.0f), "+  %s", entry.title.c_str());
+        } else {
+            ImGui::TextUnformatted(entry.title.c_str());
+        }
+        ImGui::SetWindowFontScale(1.0f);
+        if (!entry.subtitle.empty()) {
+            ImGui::TextUnformatted(entry.subtitle.c_str());
+        }
+        if (!entry.detail.empty()) {
+            const size_t end = entry.detail.find('\n');
+            ImGui::TextDisabled("%s", entry.detail.substr(0, end).c_str());
+        }
+        if (entry.mtime > 0) {
+            const std::time_t when = std::time_t(entry.mtime);
+            char date[64] = "";
+            if (const std::tm* local = std::localtime(&when)) {
+                std::strftime(date, sizeof(date), "%Y-%m-%d %H:%M", local);
+            }
+            ImGui::TextDisabled("%s", date);
+        }
+        ImGui::Unindent(pad * 2.0f);
+        ImGui::Dummy(ImVec2(row_width, pad));
+        ImGui::EndGroup();
+        const ImVec2 bottom(top.x + row_width, ImGui::GetItemRectMax().y);
+        draw->ChannelsSetCurrent(0);
+        if (selected) {
+            draw->AddRectFilled(top, bottom, IM_COL32(200, 160, 90, 70), 4.0f * base_scale);
+            draw->AddRect(top, bottom, IM_COL32(220, 180, 110, 200), 4.0f * base_scale, 0,
+                          1.5f * base_scale);
+        }
+        draw->ChannelsMerge();
+        save_rows[i] = ImVec4(top.x, top.y, bottom.x, bottom.y);
+    }
+    ImGui::EndChild();
+    ImGui::Separator();
+    ImGui::TextDisabled("Up / Down to choose, Enter or Cross (A) = OK%s",
+                        save_can_back ? ", Esc or Circle (B) = back" : "");
+    ImGui::End();
+}
