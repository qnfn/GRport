@@ -0,0 +1,269 @@
+/* Gravity Rush 2's photo album: libSceContentExport, libSceContentSearch and libSceContentDelete
+ * on a host folder, "Capture Gallery/Gravity Rush 2" in the user folder, one <id>.jpg per photo.
+ * The guest sees it at /screenshot. Adapted from GR2fork (github.com/junminlee2004/GR2fork,
+ * commit 124096c4: photo_gallery.cpp, photo_content.cpp; GPL-2.0-or-later).
+ *
+ * The game encodes a photo (runtime_image.c saves it here), exports it, asks ContentSearch for
+ * the row of what it exported and later for the whole album, and opens the paths in those rows
+ * itself. An id is "YYYYMMDD_HHMMSS_NNN", so name order is the order photos were taken in. */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include "gpu/bbgpu.h"
+#include <dirent.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#define PHOTO_SIZE 1024        /* the game renders a photo into a target of this size */
+#define MAX_PHOTOS 999         /* the game stops taking photos at 1000 */
+#define ID_LEN 24
+#define GUEST_DIR "/screenshot"
+#define EXPORT_NOTACCEPT ((int32_t)0x809D3002)
+#define SEARCH_FAIL ((int32_t)0x80000000)
+
+typedef struct { char id[ID_LEN]; uint64_t handle; char comment[257]; } Photo;
+static Photo photos[MAX_PHOTOS + 1];  /* sorted by id */
+static unsigned photo_count;
+static char host_dir[600];
+static int mounted;
+static char pending[ID_LEN];
+static char last_comment[257];
+/* The game keeps the handle of every listed photo, so a handle names one photo for the run. */
+static uint64_t next_handle = UINT64_C(0x4752324400000001); /* "GR2D", counting from 1 */
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+static void path_of(const char *id, char *out, size_t size) { snprintf(out, size, "%s/%s.jpg", host_dir, id); }
+static int find_id(const char *id) {
+    for (unsigned i = 0; i < photo_count; ++i) if (!strcmp(photos[i].id, id)) return (int)i;
+    return -1;
+}
+static int find_handle(uint64_t handle) {
+    for (unsigned i = 0; i < photo_count; ++i) if (photos[i].handle == handle) return (int)i;
+    return -1;
+}
+static void insert_id(const char *id) {
+    if (find_id(id) >= 0 || photo_count > MAX_PHOTOS) return;
+    unsigned at = 0;
+    while (at < photo_count && strcmp(photos[at].id, id) < 0) ++at;
+    memmove(photos + at + 1, photos + at, (photo_count - at) * sizeof(*photos));
+    memset(photos + at, 0, sizeof(*photos));
+    snprintf(photos[at].id, ID_LEN, "%s", id);
+    photos[at].handle = next_handle++;
+    ++photo_count;
+}
+
+static void setup(void) {
+    /* Arming also clamps the album's T# of several thousand layers (runtime_image.c reads the
+     * photo target back): it has to happen before the album is drawn. */
+    bbgpu_photo_arm(PHOTO_SIZE, PHOTO_SIZE);
+    const char *user = runtime_file_user_dir();
+    if (!user) return;
+    snprintf(host_dir, sizeof(host_dir), "%s/Capture Gallery", user);
+    mkdir(host_dir, 0755);
+    snprintf(host_dir, sizeof(host_dir), "%s/Capture Gallery/Gravity Rush 2", user);
+    if (mkdir(host_dir, 0755) && errno != EEXIST) { printf("Photo album: cannot create %s\n", host_dir); return; }
+    if (runtime_file_mount(GUEST_DIR, host_dir)) return;
+    mounted = 1;
+    DIR *dir = opendir(host_dir);
+    for (struct dirent *e; dir && (e = readdir(dir));) {
+        size_t n = strlen(e->d_name);
+        if (n < 5 || n - 4 >= ID_LEN || strcmp(e->d_name + n - 4, ".jpg")) continue;
+        int ascii = 1; /* the game opens a photo by a narrow path */
+        for (size_t i = 0; i < n; ++i) if ((unsigned char)e->d_name[i] >= 0x80) ascii = 0;
+        if (!ascii) continue;
+        char id[ID_LEN]; memcpy(id, e->d_name, n - 4); id[n - 4] = 0;
+        insert_id(id);
+    }
+    if (dir) closedir(dir);
+    printf("Photo album: %u photos in %s\n", photo_count, host_dir);
+}
+static void ensure_setup(void) { pthread_once(&once, setup); }
+
+/* ---- Called by the JPEG encoder (runtime_image.c) ---------------------------------------- */
+int runtime_photo_is_target(uint32_t width, uint32_t height) {
+    ensure_setup();
+    return width == PHOTO_SIZE && height == PHOTO_SIZE;
+}
+void runtime_photo_save(const uint8_t *jpeg, uint32_t size) {
+    ensure_setup();
+    pthread_mutex_lock(&lock);
+    pending[0] = 0;
+    if (!mounted) { pthread_mutex_unlock(&lock); return; }
+    char stamp[20], id[ID_LEN], path[700];
+    time_t now = time(NULL);
+    struct tm local;
+#ifdef _WIN32
+    localtime_s(&local, &now);
+#else
+    localtime_r(&now, &local);
+#endif
+    strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", &local);
+    struct stat st;
+    for (unsigned n = 1; n < 1000; ++n) {
+        snprintf(id, sizeof(id), "%s_%03u", stamp, n);
+        path_of(id, path, sizeof(path));
+        if (find_id(id) < 0 && stat(path, &st)) break;
+    }
+    FILE *f = fopen(path, "wb");
+    int ok = f && fwrite(jpeg, 1, size, f) == size;
+    if (f && fclose(f)) ok = 0;
+    if (!ok) { printf("Photo album: cannot write %s\n", path); remove(path); }
+    else { printf("Photo album: saved %s (%u bytes)\n", path, size); snprintf(pending, ID_LEN, "%s", id); }
+    pthread_mutex_unlock(&lock);
+}
+void runtime_photo_drop(void) { pthread_mutex_lock(&lock); pending[0] = 0; pthread_mutex_unlock(&lock); }
+
+/* ---- libSceContentExport ---------------------------------------------------------------- */
+typedef struct { char title[257]; char comment[257]; char contenttype[65]; } ExportParam;
+
+/* The exported photo is the one the encoder just saved: its id goes back to the game, which
+ * looks it up in the album right away. */
+static int32_t export_pending(const ExportParam *param, char *out, uint64_t out_size) {
+    pthread_mutex_lock(&lock);
+    if (!pending[0]) { pthread_mutex_unlock(&lock); printf("Photo album: no photo to export\n"); return EXPORT_NOTACCEPT; }
+    char id[ID_LEN]; snprintf(id, ID_LEN, "%s", pending); pending[0] = 0;
+    insert_id(id);
+    int i = find_id(id);
+    /* Where the photo was taken, as the game encodes it; read back when it is posted. */
+    if (param && i >= 0 && param->comment[0]) {
+        snprintf(photos[i].comment, sizeof(photos[i].comment), "%.256s", param->comment);
+        snprintf(last_comment, sizeof(last_comment), "%.256s", param->comment);
+    }
+    if (out && out_size) snprintf(out, out_size, "%s", id);
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+static ABI int32_t export_init(void *param) { (void)param; ensure_setup(); return 0; }
+static ABI int32_t export_ok(void) { return 0; }
+static ABI int32_t export_start(void) { return 0; } /* the export handle */
+static ABI int32_t export_from_data(int32_t handle, const ExportParam *param, uint64_t length, void *func,
+                                    void *userdata, char *out, uint64_t out_size) {
+    (void)handle; (void)length; (void)func; (void)userdata;
+    return export_pending(param, out, out_size);
+}
+static ABI int32_t export_from_data_thumb(int32_t handle, const ExportParam *param, const void *content,
+                                          const char *thumb_type, const void *thumb, char *out, uint64_t out_size) {
+    (void)handle; (void)content; (void)thumb_type; (void)thumb;
+    return export_pending(param, out, out_size);
+}
+
+/* ---- libSceContentSearch ---------------------------------------------------------------- */
+#define ROW_SIZE 0x960
+#define ROW_HANDLE 0x000
+#define ROW_TYPE 0x00C
+#define ROW_PATH 0x018
+#define ROW_TITLE 0x424
+#define ROW_THUMBNAIL 0x52B
+typedef struct { uint32_t size; uint64_t value; } SearchValue;
+typedef struct { uint32_t column, comparison; const SearchValue *value; uint32_t join; } SearchTerm;
+typedef struct { const SearchTerm *terms; int32_t num_terms; uint32_t join; } SearchCondition;
+typedef struct { uint32_t size, type; char *buffer; } MetadataValue;
+
+/* To find one photo the game passes one condition of one term: content id == its handle. */
+static uint64_t handle_asked_for(const SearchCondition *c, uint32_t n) {
+    if (!c || n != 1 || !c->terms || c->num_terms != 1) return 0;
+    const SearchTerm *t = c->terms;
+    if (t->column != 1 || t->comparison != 0 || !t->value || t->value->size != 8) return 0;
+    return t->value->value;
+}
+static ABI int32_t search_init(void *param) { (void)param; ensure_setup(); return 0; }
+static ABI int32_t search_app_index(int32_t *index) { if (index) *index = 0; return 0; }
+static ABI int32_t search_count(const void *conditions, uint32_t n, uint32_t *num, uint64_t *update_counter) {
+    (void)conditions; (void)n; ensure_setup();
+    pthread_mutex_lock(&lock);
+    if (num) *num = photo_count < MAX_PHOTOS ? photo_count : MAX_PHOTOS;
+    pthread_mutex_unlock(&lock);
+    if (update_counter) *update_counter = 0;
+    return 0;
+}
+static void fill_row(uint8_t *row, const Photo *p) {
+    char path[0x401];
+    snprintf(path, sizeof(path), GUEST_DIR "/%s.jpg", p->id); /* absolute, or the game looks in its archive */
+    const uint32_t type = 1;
+    memset(row, 0, ROW_SIZE);
+    memcpy(row + ROW_HANDLE, &p->handle, 8);
+    memcpy(row + ROW_TYPE, &type, 4);
+    snprintf((char *)row + ROW_PATH, 0x401, "%s", path);
+    snprintf((char *)row + ROW_TITLE, 0x101, "%s", p->id);
+    snprintf((char *)row + ROW_THUMBNAIL, 0x401, "%s", path);
+}
+/* A query for one handle gets that photo; any other query gets the album in name order. */
+static ABI int32_t search_content(const SearchCondition *conditions, uint32_t n, const void *sort, uint32_t num_sort,
+                                  uint32_t offset, uint32_t limit, uint64_t *hits, uint8_t *rows, uint64_t *update_counter) {
+    (void)sort; (void)num_sort;
+    if (!hits || !rows) return SEARCH_FAIL;
+    ensure_setup();
+    pthread_mutex_lock(&lock);
+    uint64_t count = 0;
+    int one = find_handle(handle_asked_for(conditions, n));
+    if (one >= 0) {
+        if (offset == 0 && limit) { fill_row(rows, &photos[one]); count = 1; }
+    } else {
+        unsigned total = photo_count < MAX_PHOTOS ? photo_count : MAX_PHOTOS;
+        for (unsigned i = offset; i < total && count < limit; ++i, ++count) fill_row(rows + count * ROW_SIZE, &photos[i]);
+    }
+    pthread_mutex_unlock(&lock);
+    /* The game adds the hit count to its offset until it has every row: an empty page fails. */
+    if (!count) return SEARCH_FAIL;
+    *hits = count;
+    if (update_counter) *update_counter = 0;
+    return 0;
+}
+static uint64_t open_content;
+static ABI int32_t search_open_metadata(uint64_t content_id, uint32_t *handle) {
+    __atomic_store_n(&open_content, content_id, __ATOMIC_RELAXED);
+    if (handle) *handle = 1;
+    return 0;
+}
+/* The only metadata a photo has is its comment. */
+static ABI int32_t search_metadata_value(uint32_t handle, const char *key, MetadataValue *value) {
+    (void)handle;
+    if (!value || !value->buffer || !value->size) return SEARCH_FAIL;
+    uint32_t size = value->size < 0x101 ? value->size : 0x101;
+    memset(value->buffer, 0, size);
+    if (key && !strcmp(key, "comment")) {
+        pthread_mutex_lock(&lock);
+        int i = find_handle(__atomic_load_n(&open_content, __ATOMIC_RELAXED));
+        /* A photo with no comment gets the last export's: a review follows the save. */
+        const char *comment = i >= 0 && photos[i].comment[0] ? photos[i].comment : last_comment;
+        snprintf(value->buffer, size, "%s", comment);
+        pthread_mutex_unlock(&lock);
+    }
+    return 0;
+}
+
+/* ---- libSceContentDelete ---------------------------------------------------------------- */
+static ABI int32_t delete_by_id(uint64_t content_id) {
+    pthread_mutex_lock(&lock);
+    int i = find_handle(content_id);
+    if (i >= 0) {
+        char path[700]; path_of(photos[i].id, path, sizeof(path));
+        remove(path);
+        printf("Photo album: deleted %s\n", photos[i].id);
+        memmove(photos + i, photos + i + 1, (photo_count - (unsigned)i - 1) * sizeof(*photos));
+        --photo_count;
+    }
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static const RuntimeExport exports[] = {
+    {"sceContentExportInit", export_init}, {"sceContentExportStart", export_start},
+    {"sceContentExportFromData", export_from_data},
+    {"sceContentExportFromDataWithThumbnail", export_from_data_thumb},
+    {"sceContentExportFinish", export_ok}, {"sceContentExportTerm", export_ok},
+    {"sceContentSearchInit", search_init}, {"sceContentSearchTerm", export_ok},
+    {"sceContentSearchGetMyApplicationIndex", search_app_index},
+    {"sceContentSearchGetNumOfContent", search_count}, {"sceContentSearchSearchContent", search_content},
+    {"sceContentSearchOpenMetadataByContentId", search_open_metadata},
+    {"sceContentSearchGetMetadataValue", search_metadata_value},
+    {"sceContentSearchCloseMetadata", export_ok},
+    {"sceContentDeleteInitialize", export_ok}, {"sceContentDeleteById", delete_by_id},
+    {"sceContentDeleteTerminate", export_ok},
+};
+uintptr_t runtime_photo_resolve(const char *name) { return RUNTIME_LOOKUP(exports, name); }
