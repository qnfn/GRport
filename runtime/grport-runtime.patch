--- a/gpu/shadps4/video_core/renderer_vulkan/vk_camera_motion.cpp
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_camera_motion.cpp
@@ -323,7 +323,66 @@ void CameraMotion::OnDisplayPass(VideoCore::ImageId frame) {
     }
     if (!frame_has_camera) InvalidateHistory();
     frame_has_camera = false;
-    depth_id = {};
+    if (!keep_depth) depth_id = {};
+}
+
+bool CameraMotion::OnGrConstants(const float* d) {
+    // An affine view (last row 0 0 0 1) and a perspective view-projection whose w row is minus
+    // the view's z row: the camera looks down -z, as in Gravity Rush.
+    if (d[3] != 0.0f || d[7] != 0.0f || d[11] != 0.0f || d[15] != 1.0f) return false;
+    for (int k = 0; k < 4; ++k) {
+        const float w = d[16 + 4 * k + 3], z = d[4 * k + 2];
+        if (std::abs(w + z) > 1e-3f * std::max(1.0f, std::abs(z))) return false;
+    }
+    if (std::abs(d[2]) + std::abs(d[6]) + std::abs(d[10]) < 0.5f) return false;
+    if (frame_has_camera) return true;
+    // View rows [R | t] (column-major input), z flipped so the camera looks down +z.
+    std::array<float, 12> view{};
+    for (int r = 0; r < 3; ++r) {
+        const float sign = r == 2 ? -1.0f : 1.0f;
+        for (int c = 0; c < 4; ++c) view[r * 4 + c] = sign * d[c * 4 + r];
+    }
+    // Its inverse: [R^T | -R^T t].
+    std::array<float, 12> inv{};
+    for (int r = 0; r < 3; ++r) {
+        for (int c = 0; c < 3; ++c) inv[r * 4 + c] = view[c * 4 + r];
+        inv[r * 4 + 3] = -(view[0 * 4 + r] * view[3] + view[1 * 4 + r] * view[7] +
+                           view[2 * 4 + r] * view[11]);
+    }
+    // Projection = view-projection * inverse view (of the unflipped view), read off the
+    // columns: x and y scale, and clip z = zs * z + zo for the flipped z.
+    const auto vp = [d](int r, int c) { return d[16 + c * 4 + r]; };
+    const auto inv_unflipped = [&inv](int r, int c) {
+        // Columns of the flipped view's inverse; the z column changes sign back.
+        if (r == 3) return c == 3 ? 1.0f : 0.0f;
+        const float v = inv[r * 4 + c];
+        return c == 2 ? -v : v;
+    };
+    const auto p = [&](int r, int c) {
+        float v = 0.0f;
+        for (int k = 0; k < 4; ++k) v += vp(r, k) * inv_unflipped(k, c);
+        return v;
+    };
+    // A camera's projection: a sane field of view and a near plane in front (other buffers
+    // pass the matrix check too: Gravity Rush 2 keeps model-view matrices per object).
+    const std::array<float, 4> proj{p(0, 0), p(1, 1), -p(2, 2), p(2, 3)};
+    if (!(proj[0] > 0.05f && proj[0] < 50.0f && proj[1] > 0.05f && proj[1] < 50.0f &&
+          proj[2] > 0.5f && proj[2] < 2.0f && proj[3] < 0.0f && proj[3] > -1000.0f)) {
+        return false;
+    }
+    previous = current;
+    current.view = view;
+    current.inv_view = inv;
+    current.proj = proj;
+    current.valid = current.proj[0] != 0.0f && current.proj[1] != 0.0f && current.proj[3] != 0.0f;
+    static bool told;
+    if (!told && current.valid) {
+        told = true;
+        std::printf("Camera motion (Gravity Rush): projection %g %g, depth = %g + %g / z\n",
+                    current.proj[0], current.proj[1], current.proj[2], current.proj[3]);
+    }
+    frame_has_camera = true;
+    return true;
 }
 
