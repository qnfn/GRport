+        }
+        return true;
+    }
+    case SDL_EVENT_MOUSE_BUTTON_DOWN: {
+        const float density = PixelDensity(event.button.windowID);
+        if (event.button.button == SDL_BUTTON_LEFT) {
+            if (const int row = SaveRowAt(event.button.x * density, event.button.y * density);
+                row >= 0) {
+                save_selected = row;
+                FinishSaveList(1);
+            }
+        } else if (event.button.button == SDL_BUTTON_RIGHT && save_can_back) {
+            FinishSaveList(2);
+        }
+        return true;
+    }
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+        return true;
+    case SDL_EVENT_MOUSE_WHEEL:
+        if (event.wheel.y != 0.0f) {
+            MoveSaveSelection(event.wheel.y > 0.0f ? -1 : 1);
+        }
+        return true;
+    default:
+        return false;
+    }
