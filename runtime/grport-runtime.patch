-u32 Rasterizer::ReadDataFromGds(u32 gds_offset) {
-    DrainDrawPipe();
-    auto* gds_buf = buffer_cache.GetGdsBuffer();
-    u32 value;
-    std::memcpy(&value, gds_buf->mapped_data.data() + gds_offset, sizeof(u32));
-    return value;
