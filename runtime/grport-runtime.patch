new file mode 100644
index 0000000..b14912e
--- /dev/null
+++ b/src/runtime_ngs2.c
@@ -0,0 +1,666 @@
+/* libSceNgs2, GRport's own: systems, racks and voices, mixed into the buffers the game then
+ * gives to sceAudioOut. Sampler voices (rack 0x1000) decode ATRAC9, VAG ADPCM or PCM waveform blocks and
+ * feed submixers (0x2000) through their ports; mastering voices (0x3000) write the render
+ * buffers. Reverb (0x2001) is silent; effect callbacks, filters, envelopes and compressors
+ * are not run. Parameter ids were read off Gravity Rush 2's calls (BB_NGS2_LOG=1 logs them). */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include "third_party/LibAtrac9/C/src/libatrac9.h"
+#include "third_party/LibAtrac9/C/src/structures.h"
+#include "hevag_coefs.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+
+#define NGS2_ERROR_INVALID_HANDLE ((int32_t)0x804A0230)
+#define NGS2_ERROR_INVALID_OUT ((int32_t)0x804A0053)
+
+typedef struct { void *host_buffer; size_t host_buffer_size; uintptr_t reserved[5]; uintptr_t user_data; } ContextBufferInfo;
+typedef struct { int32_t (ABI *alloc)(ContextBufferInfo *); int32_t (ABI *release)(ContextBufferInfo *); uintptr_t user_data; } BufferAllocator;
+typedef struct { size_t size; char name[16]; uint32_t flags, max_grain_samples, num_grain_samples, sample_rate, reserved[6]; } SystemOption;
+typedef struct { size_t size; char name[16]; uint32_t flags, max_grain_samples, max_voices, max_input_delay_blocks, max_matrices, max_ports, reserved[20]; } RackOption;
+typedef struct { uint16_t size; int16_t next; uint32_t id; } ParamHeader;
+typedef struct { void *buffer; size_t buffer_size; uint32_t waveform_type, num_channels; } RenderBufferInfo;
+typedef struct { uint32_t type, channels, sample_rate, config, frame_offset, frame_margin; } WaveformFormat;
+typedef struct { uint32_t data_offset, data_size, repeats, skip_samples, samples, reserved; uintptr_t user_data; } WaveformBlock;
+typedef struct { WaveformBlock b; const unsigned char *data; } QueuedBlock;
+typedef struct { uint32_t flags; float envelope_height, peak_height; uint32_t reserved;
+                 uint64_t decoded_samples, decoded_size, user_data; const void *waveform; } SamplerState;
+
+/* Common voice parameters. */
+#define P_MATRIX_LEVELS 0x1
+#define P_PORT_VOLUME 0x2
+#define P_PORT_MATRIX 0x3
+#define P_PATCH 0x5
+#define P_EVENT 0x6
+#define P_SAMPLER_SETUP 0x10000000
+#define P_SAMPLER_BLOCKS 0x10000001
+#define P_SAMPLER_PITCH 0x10000005
+#define P_SUBMIXER_SETUP 0x20000000
+#define P_MASTERING_SETUP 0x30000000
+#define P_MASTERING_GAIN 0x30000004
+#define P_MASTERING_OUTPUT 0x30000005
+enum { EVENT_PLAY, EVENT_STOP, EVENT_STOP_IMM, EVENT_KILL, EVENT_PAUSE, EVENT_RESUME };
+enum { STATE_IN_USE = 1, STATE_PLAYING = 2, STATE_PAUSED = 4, STATE_STOPPED = 8, STATE_ERROR = 16, STATE_EMPTY = 32 };
+/* PCM types come in big/little-endian pairs: 0x11/0x12 16-bit, 0x13/0x14 24-bit, 0x15/0x16
+ * 32-bit, 0x17/0x18 float (Gravity Rush: 0x14 sound effects, 0x18 render buffers). */
+enum { WAVE_PCM_I16L = 0x12, WAVE_PCM_F32L = 0x18, WAVE_VAG = 0x1c, WAVE_ATRAC9 = 0x40 };
+static int pcm_type(uint32_t type) { return type >= 0x11 && type <= 0x18; }
+static uint32_t pcm_bytes(uint32_t type) { return type <= 0x12 ? 2 : type <= 0x14 ? 3 : 4; }
+static float pcm_sample(uint32_t type, const unsigned char *p) {
+    const uint32_t n = pcm_bytes(type);
+    unsigned char b[4];
+    for (uint32_t i = 0; i < n; ++i) b[i] = type & 1 ? p[n - 1 - i] : p[i]; /* odd: big-endian */
+    if (n == 2) { int16_t x; memcpy(&x, b, 2); return (float)x / 32768.0f; }
+    if (n == 3) return (float)((int32_t)((uint32_t)b[0] << 8 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 24) >> 8) / 8388608.0f;
+    if (type >= 0x17) { float f; memcpy(&f, b, 4); return f; }
+    int32_t x; memcpy(&x, b, 4); return (float)x / 2147483648.0f;
+}
+enum { RACK_SAMPLER = 0x1000, RACK_SUBMIXER = 0x2000, RACK_REVERB = 0x2001, RACK_MASTERING = 0x3000 };
+
+#define CH 8
+#define PORTS 8
+#define MATRICES 4
+#define BLOCKS 16
+#define GRAIN_MAX 512
+#define FIFO 1024 /* decoded frames per sampler voice */
+
+enum { KIND_SYSTEM = 1, KIND_RACK = 2, KIND_VOICE = 3 };
+typedef struct Rack Rack;
+typedef struct Voice Voice;
+typedef struct { Voice *dest; uint32_t input; float volume; int32_t matrix; } Port;
+struct Voice {
+    int kind; Rack *rack; uint32_t index;
+    uint32_t state, channels, output;
+    Port ports[PORTS];
+    uint32_t matrix_levels[MATRICES]; float matrix[MATRICES][CH * CH];
+    float input[CH][GRAIN_MAX]; /* submixer and mastering inputs, this render */
+    float out[CH][GRAIN_MAX];
+    int pending; /* sources not mixed yet, this render */
+    /* Sampler. */
+    WaveformFormat format; float pitch;
+    const unsigned char *data; QueuedBlock blocks[BLOCKS]; uint32_t block_count, block, offset, repeats_done;
+    uint32_t skip, block_samples; uint64_t decoded_samples, decoded_size; uintptr_t user_data;
+    void *at9; Atrac9CodecInfo at9_info; uint32_t at9_frames, superframe_remain;
+    int32_t vag_history[CH][4]; /* VAG / HE-VAG predictor history, newest first */
+    float fifo[FIFO * CH]; uint32_t fifo_read, fifo_count; double phase;
+};
+struct Rack { int kind; uint32_t id, max_voices; Voice *voices; Rack *next; };
+typedef struct { int kind; uint32_t sample_rate, grain; } System;
+
+static int log_on = -1;
+static unsigned logged;
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static Rack *racks;
+
+/* Handles reach the guest, which packs pointers into 40 bits: the objects live in low memory. */
+static void *low_calloc(size_t count, size_t size) {
+    static unsigned char *pool; static size_t used, cap;
+    size_t bytes = (count * size + 15) & ~(size_t)15;
+    if (!pool || used + bytes > cap) {
+        cap = bytes > (64u << 20) ? bytes : (64u << 20);
+        pool = runtime_low_map(cap, PROT_READ | PROT_WRITE); used = 0;
+    }
+    void *p = pool ? pool + used : NULL;
+    used += bytes;
+    if (p) memset(p, 0, bytes);
+    return p;
+}
+
+static int logging(void) {
+    if (log_on < 0) { const char *e = getenv("BB_NGS2_LOG"); log_on = e && e[0] == '1'; }
+    return log_on;
+}
+
+static Voice *voice_of(uintptr_t handle) {
+    Voice *v = (Voice *)handle;
+    return v && v->kind == KIND_VOICE ? v : NULL;
+}
+
+static void reset_voice(Voice *v) {
+    v->state = 0; v->block_count = v->block = v->offset = v->repeats_done = 0;
+    v->fifo_read = v->fifo_count = 0; v->phase = 0.0; v->decoded_samples = v->decoded_size = 0;
+    v->at9_frames = 0; v->superframe_remain = 0;
+}
+
+static ABI int32_t system_create(const SystemOption *option, const BufferAllocator *allocator, uintptr_t *out) {
+    (void)allocator;
+    if (!out) return NGS2_ERROR_INVALID_OUT;
+    pthread_mutex_lock(&lock);
+    System *s = low_calloc(1, sizeof(*s));
+    pthread_mutex_unlock(&lock);
+    if (!s) return NGS2_ERROR_INVALID_OUT;
+    s->kind = KIND_SYSTEM;
+    s->sample_rate = option && option->sample_rate ? option->sample_rate : 48000;
+    s->grain = option && option->num_grain_samples ? option->num_grain_samples : 256;
+    printf("Ngs2: system %u Hz, grain %u\n", s->sample_rate, s->grain);
+    *out = (uintptr_t)s;
+    return 0;
+}
+static ABI int32_t system_destroy(uintptr_t handle, ContextBufferInfo *out) {
+    (void)handle; if (out) memset(out, 0, sizeof(*out));
+    return 0;
+}
+static ABI int32_t rack_query_buffer_size(uint32_t rack_id, const RackOption *option, ContextBufferInfo *out) {
+    (void)rack_id; (void)option;
+    if (!out) return NGS2_ERROR_INVALID_OUT;
+    memset(out, 0, sizeof(*out));
+    out->host_buffer_size = 4096; /* the voices live in host memory */
+    return 0;
+}
+static uintptr_t new_rack(uint32_t rack_id, const RackOption *option) {
+    pthread_mutex_lock(&lock);
+    Rack *r = low_calloc(1, sizeof(*r));
+    if (!r) { pthread_mutex_unlock(&lock); return 0; }
+    r->kind = KIND_RACK; r->id = rack_id;
+    r->max_voices = option && option->max_voices ? option->max_voices : 1;
+    r->voices = low_calloc(r->max_voices, sizeof(Voice));
+    if (!r->voices) r->max_voices = 0;
+    for (uint32_t i = 0; i < r->max_voices; ++i) {
+        Voice *v = &r->voices[i];
+        v->kind = KIND_VOICE; v->rack = r; v->index = i; v->channels = 2; v->pitch = 1.0f;
+        for (int p = 0; p < PORTS; ++p) { v->ports[p].volume = 1.0f; v->ports[p].matrix = -1; }
+    }
+    r->next = racks; racks = r;
+    pthread_mutex_unlock(&lock);
+    printf("Ngs2: rack 0x%x, %u voices\n", rack_id, r->max_voices);
+    return (uintptr_t)r;
+}
+static ABI int32_t rack_create(uintptr_t system, uint32_t rack_id, const RackOption *option, const ContextBufferInfo *info, uintptr_t *out) {
+    (void)system; (void)info;
+    if (!out) return NGS2_ERROR_INVALID_OUT;
+    *out = new_rack(rack_id, option);
+    return *out ? 0 : NGS2_ERROR_INVALID_OUT;
+}
+static ABI int32_t rack_create_with_allocator(uintptr_t system, uint32_t rack_id, const RackOption *option, const BufferAllocator *allocator, uintptr_t *out) {
+    (void)system; (void)allocator;
+    if (!out) return NGS2_ERROR_INVALID_OUT;
+    *out = new_rack(rack_id, option);
+    return *out ? 0 : NGS2_ERROR_INVALID_OUT;
+}
+static ABI int32_t rack_destroy(uintptr_t handle, ContextBufferInfo *out) {
+    Rack *r = (Rack *)handle;
+    if (out) memset(out, 0, sizeof(*out));
+    if (!r || r->kind != KIND_RACK) return NGS2_ERROR_INVALID_HANDLE;
+    pthread_mutex_lock(&lock);
+    for (Rack **p = &racks; *p; p = &(*p)->next) if (*p == r) { *p = r->next; break; }
+    /* Ports elsewhere that still lead here are cut; the memory stays (low pool). */
+    for (Rack *o = racks; o; o = o->next)
+        for (uint32_t i = 0; i < o->max_voices; ++i)
+            for (int p = 0; p < PORTS; ++p)
+                if (o->voices[i].ports[p].dest && o->voices[i].ports[p].dest->rack == r) o->voices[i].ports[p].dest = NULL;
+    for (uint32_t i = 0; i < r->max_voices; ++i) if (r->voices[i].at9) Atrac9ReleaseHandle(r->voices[i].at9);
+    r->kind = 0;
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+static ABI int32_t rack_get_voice_handle(uintptr_t handle, uint32_t index, uintptr_t *out) {
+    Rack *r = (Rack *)handle;
+    if (!r || r->kind != KIND_RACK) return NGS2_ERROR_INVALID_HANDLE;
+    if (!out) return NGS2_ERROR_INVALID_OUT;
+    if (index >= r->max_voices) return NGS2_ERROR_INVALID_HANDLE;
+    *out = (uintptr_t)&r->voices[index];
+    return 0;
+}
+
+static void setup_sampler(Voice *v, const WaveformFormat *format) {
+    reset_voice(v);
+    v->format = *format;
+    v->channels = format->channels > CH ? CH : format->channels ? format->channels : 1;
+    if (format->type == WAVE_ATRAC9) {
+        unsigned char config[4] = {(unsigned char)(format->config >> 24), (unsigned char)(format->config >> 16),
+                                   (unsigned char)(format->config >> 8), (unsigned char)format->config};
+        if (!v->at9) v->at9 = Atrac9GetHandle();
+        if (v->at9 && Atrac9InitDecoder(v->at9, config) == 0) {
+            Atrac9GetCodecInfo(v->at9, &v->at9_info);
+        } else {
+            memset(&v->at9_info, 0, sizeof(v->at9_info));
+            printf("Ngs2: ATRAC9 config %08x rejected\n", format->config);
+        }
+    } else if (!pcm_type(format->type) && format->type != WAVE_VAG) {
+        static int told;
+        if (told++ < 8) printf("Ngs2: waveform type 0x%x not supported (silent)\n", format->type);
+    }
+}
+
+static void start_block(Voice *v) {
+    const WaveformBlock *b = &v->blocks[v->block].b;
+    v->data = v->blocks[v->block].data;
+    v->offset = 0; v->skip = b->skip_samples; v->block_samples = 0;
+    v->at9_frames = 0; v->superframe_remain = (uint32_t)v->at9_info.superframeSize;
+    /* A block starts on a superframe, so must the decoder: left mid-superframe (a loop back
+     * after a partial one), it rejects every first frame with SUPERFRAME_FLAG_INVALID, and
+     * never advances past it. */
+    if (v->at9) ((Atrac9Handle *)v->at9)->Frame.IndexInSuperframe = 0;
+    memset(v->vag_history, 0, sizeof(v->vag_history));
+}
+
+static void set_blocks(Voice *v, const unsigned char *data, uint32_t count, const WaveformBlock *blocks) {
+    if (logging() && logged < 6000) {
+        ++logged;
+        printf("Ngs2: voice %u blocks at %p:", v->index, (const void *)data);
+        for (uint32_t i = 0; i < count && i < 4; ++i)
+            printf(" [off %u size %u rep %u skip %u n %u]", blocks[i].data_offset, blocks[i].data_size,
+                   blocks[i].repeats, blocks[i].skip_samples, blocks[i].samples);
+        printf("\n");
+    }
+    /* More data for a voice that still has blocks: queued after them (streaming); the played
+     * ones make room. */
+    const int append = v->block < v->block_count;
+    if (!append) v->block_count = v->block = v->repeats_done = 0;
+    if (append && v->block && v->block_count + count > BLOCKS) {
+        memmove(v->blocks, v->blocks + v->block, (v->block_count - v->block) * sizeof(*v->blocks));
+        v->block_count -= v->block; v->block = 0;
+    }
+    for (uint32_t i = 0; i < count && v->block_count < BLOCKS; ++i) {
+        v->blocks[v->block_count].b = blocks[i]; v->blocks[v->block_count++].data = data;
+    }
+    if (!append && v->block_count) { start_block(v); v->user_data = v->blocks[0].b.user_data; }
+    v->state &= ~(uint32_t)STATE_EMPTY;
+}
+
+static void control(Voice *v, const ParamHeader *param) {
+    const uint32_t *w = (const uint32_t *)param;
+    const uint32_t rack = v->rack->id;
+    switch (param->id) {
+    case P_MATRIX_LEVELS: {
+        const uint32_t id = w[2], count = w[3];
+        const float *levels = *(const float *const *)(w + 4);
+        if (id < MATRICES && levels) {
+            const uint32_t n = count > CH * CH ? CH * CH : count;
+            memcpy(v->matrix[id], levels, n * sizeof(float));
+            v->matrix_levels[id] = n;
+            if (logging() && logged < 6000) {
+                ++logged; printf("Ngs2: voice %u matrix %u:", v->index, id);
+                for (uint32_t i = 0; i < n; ++i) printf(" %.2f", (double)levels[i]);
+                printf("\n");
+            }
+        }
+        break;
+    }
+    case P_PORT_VOLUME: if (w[2] < PORTS) { float f; memcpy(&f, w + 3, 4); v->ports[w[2]].volume = f; } break;
+    case P_PORT_MATRIX: if (w[2] < PORTS) v->ports[w[2]].matrix = (int32_t)w[3]; break;
+    case P_PATCH:
+        if (w[2] < PORTS) {
+            v->ports[w[2]].input = w[3];
+            const uintptr_t dest = *(const uintptr_t *)(w + 4);
+            /* A rack handle stands for its first voice. */
+            const Rack *r = (const Rack *)dest;
+            v->ports[w[2]].dest = r && r->kind == KIND_RACK ? (r->max_voices ? &r->voices[0] : NULL) : voice_of(dest);
+        }
+        break;
+    case P_EVENT:
+        switch (w[2]) {
+        case EVENT_PLAY: v->state = (v->state & ~(uint32_t)STATE_STOPPED) | STATE_IN_USE | STATE_PLAYING; break;
+        case EVENT_STOP: case EVENT_STOP_IMM: v->state = STATE_STOPPED; v->fifo_count = 0; break;
+        case EVENT_KILL: reset_voice(v); break;
+        case EVENT_PAUSE: v->state |= STATE_PAUSED; break;
+        case EVENT_RESUME: v->state &= ~(uint32_t)STATE_PAUSED; break;
+        }
+        break;
+    default:
+        if (rack == RACK_SAMPLER && param->id == P_SAMPLER_SETUP) {
+            setup_sampler(v, (const WaveformFormat *)(w + 2));
+        } else if (rack == RACK_SAMPLER && param->id == P_SAMPLER_BLOCKS) {
+            const unsigned char *data = *(const unsigned char *const *)(w + 2);
+            const WaveformBlock *blocks = *(const WaveformBlock *const *)(w + 6);
+            if (blocks) set_blocks(v, data, w[5], blocks);
+        } else if (rack == RACK_SAMPLER && param->id == P_SAMPLER_PITCH) {
+            float f; memcpy(&f, w + 2, 4); v->pitch = f > 0.0f && f < 16.0f ? f : 1.0f;
+        } else if (param->id == P_SUBMIXER_SETUP || param->id == P_MASTERING_SETUP ||
+                   (param->id & 0xffff) == 0) { /* rack setups: their channel count first */
+            if (w[2] >= 1 && w[2] <= CH) v->channels = w[2];
+        } else if (param->id == P_MASTERING_OUTPUT) {
+            v->output = w[2];
+        } else if (param->id == P_MASTERING_GAIN) {
+            /* fbw and lfe levels: 1 in Gravity Rush; not applied */
+        }
+        break;
+    }
+}
+
+static ABI int32_t voice_control(uintptr_t handle, const ParamHeader *param) {
+    Voice *v = voice_of(handle);
+    if (!v) return NGS2_ERROR_INVALID_HANDLE;
+    pthread_mutex_lock(&lock);
+    for (int n = 0; param && n < 64; ++n) {
+        /* BB_NGS2_LOG: the first few of each parameter, and every sampler event. */
+        static uint32_t seen_id[256]; static unsigned seen_count[256];
+        unsigned slot = 0;
+        if (logging()) {
+            while (slot < 255 && seen_id[slot] && seen_id[slot] != param->id) ++slot;
+            seen_id[slot] = param->id;
+        }
+        if (logging() && logged < 6000 && (seen_count[slot]++ < 6 || (param->id == P_EVENT && v->rack->id == RACK_SAMPLER))) {
+            ++logged;
+            const uint32_t *w = (const uint32_t *)param;
+            printf("Ngs2: rack 0x%x voice %u param 0x%x size %u next %d:", v->rack->id, v->index, param->id, param->size, param->next);
+            for (unsigned i = 2; i < param->size / 4u && i < 16; ++i) printf(" %08x", w[i]);
+            printf("\n");
+        }
+        control(v, param);
+        if (!param->next) break;
+        param = (const ParamHeader *)((const char *)param + param->next);
+    }
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static ABI int32_t voice_get_state(uintptr_t handle, void *out, size_t size) {
+    Voice *v = voice_of(handle);
+    if (!v) return NGS2_ERROR_INVALID_HANDLE;
+    if (!out || !size) return NGS2_ERROR_INVALID_OUT;
+    pthread_mutex_lock(&lock);
+    SamplerState s = {0};
+    s.flags = v->state; s.envelope_height = v->state & STATE_PLAYING ? 1.0f : 0.0f;
+    s.decoded_samples = v->decoded_samples; s.decoded_size = v->decoded_size;
+    s.user_data = v->user_data; s.waveform = v->data;
+    pthread_mutex_unlock(&lock);
+    memset(out, 0, size);
+    memcpy(out, &s, size < sizeof(s) ? size : sizeof(s));
+    return 0;
+}
+
+/* The next block, or none left: the voice has played its data. */
+static int next_block(Voice *v) {
+    const WaveformBlock *b = &v->blocks[v->block].b;
+    if (b->repeats == 0xffffffffu || v->repeats_done < b->repeats) {
+        ++v->repeats_done; start_block(v); return 1;
+    }
+    v->repeats_done = 0;
+    if (++v->block >= v->block_count) {
+        v->block = v->block_count = 0;
+        v->state = (v->state & ~(uint32_t)(STATE_PLAYING | STATE_IN_USE)) | STATE_EMPTY;
+        return 0;
+    }
+    v->user_data = v->blocks[v->block].b.user_data;
+    start_block(v);
+    return 1;
+}
+
+static void push_frames(Voice *v, const float *frames, uint32_t count) {
+    const WaveformBlock *b = &v->blocks[v->block].b;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (v->skip) { --v->skip; continue; }
+        if (b->samples && v->block_samples >= b->samples) break;
+        ++v->block_samples;
+        if (v->fifo_count >= FIFO) break;
+        const uint32_t at = (v->fifo_read + v->fifo_count) % FIFO;
+        memcpy(&v->fifo[at * CH], &frames[i * CH], CH * sizeof(float));
+        ++v->fifo_count;
+    }
+    v->decoded_samples += count;
+}
+
+/* Decodes one ATRAC9 frame or a run of PCM into the voice's FIFO. Returns 0 at the end. */
+static int decode_some(Voice *v) {
+    if (!v->block_count || !v->data) return 0;
+    const WaveformBlock *b = &v->blocks[v->block].b;
+    const unsigned char *src = v->data + b->data_offset + v->offset;
+    const uint32_t left = b->data_size > v->offset ? b->data_size - v->offset : 0;
+    const int done = left == 0 || (b->samples && v->block_samples >= b->samples);
+    if (done) return next_block(v);
+    float frames[256 * CH];
+    memset(frames, 0, sizeof(frames));
+    const uint32_t ch = v->channels;
+    if (v->format.type == WAVE_ATRAC9 && v->at9_info.frameSamples) {
+        int16_t pcm[256 * CH]; int used = 0;
+        const int in_ch = v->at9_info.channels;
+        if (v->at9_info.frameSamples > 256 || in_ch > CH || Atrac9Decode(v->at9, src, pcm, &used) || used <= 0) {
+            v->offset = b->data_size; /* broken data: skip the block */
+            ((Atrac9Handle *)v->at9)->Frame.IndexInSuperframe = 0;
+            return 1;
+        }
+        for (int i = 0; i < v->at9_info.frameSamples; ++i)
+            for (int c = 0; c < in_ch; ++c) frames[i * CH + c] = (float)pcm[i * in_ch + c] / 32768.0f;
+        v->offset += (uint32_t)used; v->superframe_remain -= (uint32_t)used; v->decoded_size += (uint32_t)used;
+        if (++v->at9_frames == (uint32_t)v->at9_info.framesInSuperframe) {
+            v->offset += v->superframe_remain; v->decoded_size += v->superframe_remain;
+            v->superframe_remain = (uint32_t)v->at9_info.superframeSize; v->at9_frames = 0;
+        }
+        push_frames(v, frames, (uint32_t)v->at9_info.frameSamples);
+    } else if (v->format.type == WAVE_VAG) {
+        /* Sony ADPCM, VAG and HE-VAG (the same type): 16-byte frames of 28 samples, one frame
+         * per channel in turn. HE-VAG's predictor index has 7 bits (the high 3 in byte 1's
+         * high nibble) into 128 sets of 4 coefficients over 4 history samples; indexes 0-4 are
+         * classic VAG. Gravity Rush 2's sound effects and voices are HE-VAG (sndx codec 0x21):
+         * read as classic VAG (index > 4 treated as 0), they decoded to heavy distortion.
+         * Flag 7 is a silent frame. As vgmstream's decode_hevag: no clamping in the history. */
+        if (left < 16 * ch) { v->offset = b->data_size; return 1; }
+        for (uint32_t c = 0; c < ch; ++c) {
+            const unsigned char *f = src + 16 * c;
+            const int shift = f[0] & 15, flag = f[1] & 15;
+            int index = (f[0] >> 4) | (f[1] & 0xf0);
+            if (index > 127) index = 0;
+            const float *k = hevag_coefs[index];
+            int32_t *h = v->vag_history[c];
+            for (int i = 0; i < 28; ++i) {
+                int32_t x = 0;
+                if (flag < 7) {
+                    const int nibble = (f[2 + i / 2] >> ((i & 1) * 4)) & 15;
+                    const int32_t code = (int32_t)(int16_t)(uint16_t)(nibble << 12);
+                    x = (code >> shift) + (int32_t)((float)h[0] * k[0] + (float)h[1] * k[1] +
+                                                   (float)h[2] * k[2] + (float)h[3] * k[3]);
+                }
+                h[3] = h[2]; h[2] = h[1]; h[1] = h[0]; h[0] = x;
+                frames[i * CH + c] = (float)(x > 32767 ? 32767 : x < -32768 ? -32768 : x) / 32768.0f;
+            }
+        }
+        v->offset += 16 * ch; v->decoded_size += 16 * ch;
+        push_frames(v, frames, 28);
+    } else if (pcm_type(v->format.type)) {
+        const uint32_t bytes = pcm_bytes(v->format.type);
+        uint32_t n = left / (bytes * ch);
+        if (n > 256) n = 256;
+        if (!n) { v->offset = b->data_size; return 1; }
+        for (uint32_t i = 0; i < n; ++i)
+            for (uint32_t c = 0; c < ch; ++c) {
+                const unsigned char *s = src + ((size_t)i * ch + c) * bytes;
+                frames[i * CH + c] = pcm_sample(v->format.type, s);
+            }
+        v->offset += n * bytes * ch; v->decoded_size += n * bytes * ch;
+        push_frames(v, frames, n);
+    } else {
+        v->offset = b->data_size;
+    }
+    return 1;
+}
+
+/* A looping block that yields no samples (undecodable ATRAC9, or skip_samples past its data)
+ * restarts forever: decode_some never returns 0, and the game's mixer thread spun inside
+ * sceNgs2SystemRender with all sound gone (Gravity Rush 2 after its first load). Decoding
+ * this many times without a sample ends the voice instead, as if its data had run out. */
+#define DECODE_IDLE_LIMIT 4096
+
+static void end_stuck_voice(Voice *v) {
+    static int reported;
+    if (reported++ < 8) {
+        const WaveformBlock *b = &v->blocks[v->block].b;
+        fprintf(stderr, "Ngs2: voice %u (rack 0x%x) stopped: no samples from its data (type %u, %u ch, "
+                "block %u/%u off %u size %u rep %u skip %u n %u)\n", v->index, v->rack->id,
+                v->format.type, v->channels, v->block, v->block_count, b->data_offset, b->data_size,
+                b->repeats, b->skip_samples, b->samples);
+    }
+    v->block = v->block_count = 0;
+    v->state = (v->state & ~(uint32_t)(STATE_PLAYING | STATE_IN_USE)) | STATE_EMPTY;
+}
+
+/* One grain of a playing sampler voice into v->out, resampled to the system rate. */
+static void render_sampler(Voice *v, uint32_t frames, uint32_t rate) {
+    const double step = (double)v->pitch * (double)(v->format.sample_rate ? v->format.sample_rate : rate) / (double)rate;
+    for (uint32_t i = 0; i < frames; ++i) {
+        for (uint32_t idle = 0; v->fifo_count < 2 && (v->state & STATE_PLAYING); ) {
+            const uint32_t had = v->fifo_count;
+            if (!decode_some(v)) break;
+            if (v->fifo_count != had) idle = 0;
+            else if (++idle >= DECODE_IDLE_LIMIT) { end_stuck_voice(v); break; }
+        }
+        if (v->fifo_count == 0) { for (uint32_t c = 0; c < CH; ++c) v->out[c][i] = 0.0f; continue; }
+        const float *a = &v->fifo[v->fifo_read * CH];
+        const float *b = v->fifo_count > 1 ? &v->fifo[((v->fifo_read + 1) % FIFO) * CH] : a;
+        const float t = (float)v->phase;
+        for (uint32_t c = 0; c < CH; ++c) v->out[c][i] = a[c] + (b[c] - a[c]) * t;
+        v->phase += step;
+        while (v->phase >= 1.0 && v->fifo_count) { v->phase -= 1.0; v->fifo_read = (v->fifo_read + 1) % FIFO; --v->fifo_count; }
+    }
+}
+
+/* v->out through each patched port into its destination's input. */
+static void send(Voice *v, uint32_t frames) {
+    for (int p = 0; p < PORTS; ++p) {
+        const Port *port = &v->ports[p];
+        Voice *d = port->dest;
+        if (!d || port->volume == 0.0f) continue;
+        const uint32_t out_ch = d->channels, in_ch = v->channels;
+        const int m = port->matrix;
+        if (m >= 0 && m < MATRICES && v->matrix_levels[m] >= in_ch * out_ch) {
+            const float *levels = v->matrix[m]; /* levels[out * inputs + in] */
+            for (uint32_t i = 0; i < in_ch; ++i)
+                for (uint32_t o = 0; o < out_ch; ++o) {
+                    const float g = levels[o * in_ch + i] * port->volume;
+                    if (g != 0.0f) for (uint32_t s = 0; s < frames; ++s) d->input[o][s] += v->out[i][s] * g;
+                }
+        } else {
+            const uint32_t n = in_ch < out_ch ? in_ch : out_ch;
+            for (uint32_t c = 0; c < n; ++c)
+                for (uint32_t s = 0; s < frames; ++s) d->input[c][s] += v->out[c][s] * port->volume;
+        }
+    }
+}
+
+static ABI int32_t system_render(uintptr_t handle, const RenderBufferInfo *buffers, uint32_t count) {
+    const System *sys = (const System *)handle;
+    const uint32_t rate = sys && sys->kind == KIND_SYSTEM ? sys->sample_rate : 48000;
+    static int told;
+    uint32_t frames = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (!told) printf("Ngs2: render buffer %u: %zu bytes, type 0x%x, %u ch\n", i, buffers[i].buffer_size, buffers[i].waveform_type, buffers[i].num_channels);
+        const uint32_t bytes = buffers[i].waveform_type == WAVE_PCM_I16L ? 2 : 4;
+        if (buffers[i].num_channels) frames = (uint32_t)(buffers[i].buffer_size / (bytes * buffers[i].num_channels));
+        if (buffers[i].buffer) memset(buffers[i].buffer, 0, buffers[i].buffer_size);
+    }
+    told = 1;
+    if (frames > GRAIN_MAX) frames = GRAIN_MAX;
+    if (!frames) return 0;
+    pthread_mutex_lock(&lock);
+    /* Inputs cleared; each mixing voice counts the voices that still feed it. */
+    for (Rack *r = racks; r; r = r->next) {
+        if (r->id == RACK_SAMPLER) continue;
+        for (uint32_t i = 0; i < r->max_voices; ++i) {
+            Voice *v = &r->voices[i];
+            for (uint32_t c = 0; c < CH; ++c) memset(v->input[c], 0, frames * sizeof(float));
+            v->pending = 0;
+        }
+    }
+    for (Rack *r = racks; r; r = r->next)
+        if (r->id != RACK_SAMPLER && r->id != RACK_MASTERING)
+            for (uint32_t i = 0; i < r->max_voices; ++i)
+                for (int p = 0; p < PORTS; ++p) if (r->voices[i].ports[p].dest) ++r->voices[i].ports[p].dest->pending;
+    /* Sampler voices first. */
+    for (Rack *r = racks; r; r = r->next) {
+        if (r->id != RACK_SAMPLER) continue;
+        for (uint32_t i = 0; i < r->max_voices; ++i) {
+            Voice *v = &r->voices[i];
+            /* A paused voice decodes ahead, like the hardware's: games wait for that before
+             * they resume a prepared stream. */
+            if ((v->state & (STATE_PLAYING | STATE_PAUSED)) == (STATE_PLAYING | STATE_PAUSED)) {
+                while (v->fifo_count < 512 && decode_some(v)) {}
+                continue;
+            }
+            if ((v->state & (STATE_PLAYING | STATE_PAUSED)) != STATE_PLAYING) continue;
+            render_sampler(v, frames, rate);
+            send(v, frames);
+        }
+    }
+    /* Mixing voices once everything feeding them is in (a few passes: chains of submixers). */
+    for (int pass = 0; pass < 16; ++pass) {
+        int progress = 0, waiting = 0;
+        for (Rack *r = racks; r; r = r->next) {
+            if (r->id == RACK_SAMPLER || r->id == RACK_MASTERING) continue;
+            for (uint32_t i = 0; i < r->max_voices; ++i) {
+                Voice *v = &r->voices[i];
+                if (v->pending < 0) continue;
+                if (v->pending > 0) { ++waiting; continue; }
+                v->pending = -1; ++progress;
+                for (uint32_t c = 0; c < CH; ++c) {
+                    if (r->id == RACK_REVERB) memset(v->out[c], 0, frames * sizeof(float));
+                    else memcpy(v->out[c], v->input[c], frames * sizeof(float));
+                }
+                send(v, frames);
+                for (int p = 0; p < PORTS; ++p) if (v->ports[p].dest) --v->ports[p].dest->pending;
+            }
+        }
+        if (!waiting || !progress) break;
+    }
+    /* Mastering voices write the render buffers. */
+    for (Rack *r = racks; r; r = r->next) {
+        if (r->id != RACK_MASTERING) continue;
+        for (uint32_t i = 0; i < r->max_voices; ++i) {
+            const Voice *v = &r->voices[i];
+            if (v->output >= count || !buffers[v->output].buffer) continue;
+            const RenderBufferInfo *b = &buffers[v->output];
+            const uint32_t ch = b->num_channels < v->channels ? b->num_channels : v->channels;
+            for (uint32_t s = 0; s < frames; ++s)
+                for (uint32_t c = 0; c < ch; ++c) {
+                    float x = v->input[c][s];
+                    x = x > 1.0f ? 1.0f : x < -1.0f ? -1.0f : x;
+                    if (b->waveform_type == WAVE_PCM_I16L) ((int16_t *)b->buffer)[s * b->num_channels + c] = (int16_t)(x * 32767.0f);
+                    else ((float *)b->buffer)[s * b->num_channels + c] += x;
+                }
+        }
+    }
+    if (logging()) {
+        static uint32_t renders; static float peak; static unsigned playing_max;
+        unsigned playing = 0;
+        for (Rack *r = racks; r; r = r->next)
+            if (r->id == RACK_SAMPLER)
+                for (uint32_t i = 0; i < r->max_voices; ++i)
+                    if ((r->voices[i].state & (STATE_PLAYING | STATE_PAUSED)) == STATE_PLAYING) ++playing;
+        if (playing > playing_max) playing_max = playing;
+        if (count && buffers[0].buffer && buffers[0].waveform_type == WAVE_PCM_F32L)
+            for (size_t k = 0; k < buffers[0].buffer_size / 4; ++k) {
+                const float x = fabsf(((const float *)buffers[0].buffer)[k]);
+                if (x > peak) peak = x;
+            }
+        if (renders * frames + frames >= rate) {
+            /* The first sampler voice and the mastering inputs, for the report. */
+            for (Rack *r = racks; r; r = r->next) {
+                if (r->id != RACK_SAMPLER && r->id != RACK_MASTERING) continue;
+                for (uint32_t i = 0; i < r->max_voices && i < 2; ++i) {
+                    const Voice *v = &r->voices[i];
+                    float in = 0.0f, out = 0.0f;
+                    for (uint32_t c = 0; c < CH; ++c)
+                        for (uint32_t k = 0; k < frames; ++k) {
+                            if (fabsf(v->input[c][k]) > in) in = fabsf(v->input[c][k]);
+                            if (fabsf(v->out[c][k]) > out) out = fabsf(v->out[c][k]);
+                        }
+                    printf("Ngs2:  rack 0x%x voice %u state 0x%x ch %u blocks %u/%u fifo %u decoded %llu in %.3f out %.3f port0 %p vol %.2f matrix %d\n",
+                           r->id, i, v->state, v->channels, v->block, v->block_count, v->fifo_count,
+                           (unsigned long long)v->decoded_samples, (double)in, (double)out,
+                           (void *)v->ports[0].dest, (double)v->ports[0].volume, v->ports[0].matrix);
+                }
+            }
+        }
+        if (++renders * frames >= rate) {
+            printf("Ngs2: last second: %u renders, up to %u sampler voices playing, peak %.3f\n", renders, playing_max, (double)peak);
+            renders = 0; peak = 0.0f; playing_max = 0;
+        }
+    }
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static const RuntimeExport exports[] = {
+    {"sceNgs2SystemCreateWithAllocator", system_create}, {"sceNgs2SystemDestroy", system_destroy},
+    {"sceNgs2SystemRender", system_render}, {"sceNgs2RackQueryBufferSize", rack_query_buffer_size},
+    {"sceNgs2RackCreate", rack_create}, {"sceNgs2RackCreateWithAllocator", rack_create_with_allocator},
+    {"sceNgs2RackDestroy", rack_destroy}, {"sceNgs2RackGetVoiceHandle", rack_get_voice_handle},
+    {"sceNgs2VoiceControl", voice_control}, {"sceNgs2VoiceGetState", voice_get_state},
+};
+/* BB_NGS2=0: the game gets the lenient stubs instead (comparisons). */
+uintptr_t runtime_ngs2_resolve(const char *name) {
+    const char *off = getenv("BB_NGS2");
+    return off && off[0] == '0' ? 0 : RUNTIME_LOOKUP(exports, name);
+}
