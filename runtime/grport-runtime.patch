+/* BB_STICK_DEADZONE (percent, 0-90; the launcher's SETUP > Stick dead zone): a radial dead
+ * zone on each whole stick, for worn or wobbly sticks (drift, TMR jitter) that moved the
+ * character on their own. Inside the circle the stick reads centred; outside it the distance
+ * is rescaled so motion starts from 0 at the edge and full deflection stays full, and the
+ * direction is kept (a per-axis dead zone would snap near-diagonal input onto the axes).
+ * 0 or unset: off. Runs after input.ini's per-axis analog_deadzone, which still applies. */
+static int stick_deadzone_percent(void) {
+    static int value=-1;
+    if (value<0) {
+        const char *env=getenv("BB_STICK_DEADZONE");
+        char *end=NULL;
+        long v=env && env[0] ? strtol(env,&end,10) : 0;
+        value=env && env[0] && end && !*end && v>=0 && v<=90 ? (int)v : 0;
+        if (value) printf("Runtime: stick dead zone %d%% (radial)\n",value);
+    }
+    return value;
+}
+static void apply_radial_deadzone(int *x, int *y, int percent) {
+    if (percent<=0) return;
+    const double radius=127.0*percent/100.0, mag=sqrt((double)*x * *x + (double)*y * *y);
+    if (mag<=radius) { *x=0; *y=0; return; }
+    const double scale=(mag-radius)/(127.0-radius)*127.0/mag;
+    const long nx=lround(*x*scale), ny=lround(*y*scale);
+    *x=nx<-127 ? -127 : nx>127 ? 127 : (int)nx;
+    *y=ny<-127 ? -127 : ny>127 ? 127 : (int)ny;
+}
