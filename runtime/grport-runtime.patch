+/// A bumper (LB, RB): a silver bar with dark letters; a trigger (LT, RT): taller and rounded on
+/// top. Both keep the game's icon size and leave its edges transparent.
+void Shoulder360(DcCanvas& c, const char* name, bool trigger) {
+    const float x0 = 6, x1 = c.w - 6.0f;
+    const float y0 = trigger ? 6.0f : 14.0f, y1 = c.h - (trigger ? 6.0f : 14.0f);
+    const float r_top = trigger ? (y1 - y0) * 0.45f : (y1 - y0) * 0.38f, r_bottom = trigger ? 5.0f : (y1 - y0) * 0.38f;
+    Rounded(c, x0, y0, x1, y1, r_top, r_bottom, {70, 70, 74, 255}, {40, 40, 44, 255});
+    Rounded(c, x0 + 2, y0 + 2, x1 - 2, y1 - 2, r_top - 2, r_bottom - 2, {238, 238, 240, 255}, {168, 170, 176, 255});
+    DcText(c, name, c.w / 2.0f, (y0 + y1) / 2 + 1, (y1 - y0) * 0.62f, (x1 - x0) * 0.8f, kInk, false);
+}
+
+/// A stick pressed (L3, R3): the dark stick top with a lighter ring and its name.
+void Stick360(DcCanvas& c, const char* name) {
+    const float cx = c.w / 2.0f, cy = c.h / 2.0f, r = c.w * 0.46f;
+    Disc(c, cx, cy, r, {28, 28, 30, 255}, {12, 12, 14, 255});
+    Disc(c, cx, cy, r - 2.2f, {98, 98, 104, 255}, {52, 52, 56, 255});
+    Disc(c, cx, cy, r - 6.5f, {58, 58, 62, 255}, {78, 78, 84, 255});
+    DcText(c, name, cx, cy + 0.5f, c.h * 0.38f, r * 1.5f, kWhite, true);
+}
+
+/// A thick line from (x0, y0) to (x1, y1) with round ends.
+void Segment(DcCanvas& c, float x0, float y0, float x1, float y1, float width, Color color) {
+    Fill(c, 0, float(c.h), color, color, [=](float px, float py) {
+        const float dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;
+        const float t = len2 > 0 ? std::clamp(((px - x0) * dx + (py - y0) * dy) / len2, 0.0f, 1.0f) : 0;
+        const float qx = x0 + t * dx - px, qy = y0 + t * dy - py;
+        return qx * qx + qy * qy <= width * width / 4;
+    });
+}
+
+void Ring(DcCanvas& c, float cx, float cy, float r, float width, Color color) {
+    Fill(c, 0, float(c.h), color, color, [=](float px, float py) {
+        const float d = std::sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
+        return std::abs(d - r) <= width / 2;
+    });
+}
+
+/// The dark round button the Xbox One and DualSense prompts sit on.
+void DarkButton(DcCanvas& c) {
+    const float cx = c.w / 2.0f, cy = c.h / 2.0f, r = c.w * 0.46f;
+    Disc(c, cx, cy, r, {92, 92, 98, 255}, {54, 54, 60, 255});
+    Disc(c, cx, cy, r - 1.8f, {40, 40, 44, 255}, {20, 20, 22, 255});
+}
+
+/// Xbox One: the letter in the button's colour on the dark button.
+void FlatFace(DcCanvas& c, const char* letter, Color color) {
+    DarkButton(c);
+    DcText(c, letter, c.w / 2.0f, c.h / 2.0f + 0.5f, c.h * 0.56f, c.w * 0.6f, color, false);
+}
+
+/// A dark bumper or trigger with its name in white (Xbox One, DualSense).
+void DarkShoulder(DcCanvas& c, const char* name, bool trigger) {
+    const float x0 = 6, x1 = c.w - 6.0f;
+    const float y0 = trigger ? 6.0f : 14.0f, y1 = c.h - (trigger ? 6.0f : 14.0f);
+    const float r_top = trigger ? (y1 - y0) * 0.45f : (y1 - y0) * 0.38f, r_bottom = trigger ? 5.0f : (y1 - y0) * 0.38f;
+    Rounded(c, x0, y0, x1, y1, r_top, r_bottom, {92, 92, 98, 255}, {54, 54, 60, 255});
+    Rounded(c, x0 + 1.8f, y0 + 1.8f, x1 - 1.8f, y1 - 1.8f, r_top - 1.8f, r_bottom - 1.8f, {40, 40, 44, 255},
+            {20, 20, 22, 255});
+    DcText(c, name, c.w / 2.0f, (y0 + y1) / 2 + 1, (y1 - y0) * 0.62f, (x1 - x0) * 0.8f, kWhite, false);
+}
+
+/// A dark stick top with its name in white (Xbox One, DualSense).
+void DarkStick(DcCanvas& c, const char* name) {
+    DarkButton(c);
+    Ring(c, c.w / 2.0f, c.h / 2.0f, c.w * 0.3f, 1.6f, {110, 110, 116, 255});
+    DcText(c, name, c.w / 2.0f, c.h / 2.0f + 0.5f, c.h * 0.36f, c.w * 0.5f, kWhite, false);
+}
+
+/// Xbox One's View button: two overlapping windows on the dark button.
+void View(DcCanvas& c) {
+    const float s = std::min(c.w, c.h) * 0.92f, cx = c.w / 2.0f, cy = c.h / 2.0f;
+    Disc(c, cx, cy, s / 2, {92, 92, 98, 255}, {54, 54, 60, 255});
+    Disc(c, cx, cy, s / 2 - 1.8f, {40, 40, 44, 255}, {20, 20, 22, 255});
+    const float u = s / 32;  // the icon drawn on a 32-unit grid
+    const Color line = kWhite, back{40, 40, 44, 255};
+    Rounded(c, cx - 4 * u, cy - 7 * u, cx + 7 * u, cy + 2 * u, 1.2f * u, 1.2f * u, line, line);
+    Rounded(c, cx - 2.4f * u, cy - 5.4f * u, cx + 5.4f * u, cy + 0.4f * u, 0.5f * u, 0.5f * u, back, back);
+    Rounded(c, cx - 7 * u, cy - 2 * u, cx + 4 * u, cy + 7 * u, 1.2f * u, 1.2f * u, line, line);
+    Rounded(c, cx - 5.4f * u, cy - 0.4f * u, cx + 2.4f * u, cy + 5.4f * u, 0.5f * u, 0.5f * u, back, back);
+}
+
+/// DualSense-style symbols: light outlines on the dark button.
+void PsFace(DcCanvas& c, DcIcon icon) {
+    DarkButton(c);
+    const float cx = c.w / 2.0f, cy = c.h / 2.0f, k = c.w / 48.0f, wdt = 3.4f * k;
+    const Color ink{232, 232, 236, 255};
+    switch (icon) {
+    case DcCross:
+        Segment(c, cx - 9 * k, cy - 9 * k, cx + 9 * k, cy + 9 * k, wdt, ink);
+        Segment(c, cx - 9 * k, cy + 9 * k, cx + 9 * k, cy - 9 * k, wdt, ink);
+        break;
+    case DcCircle: Ring(c, cx, cy, 9.5f * k, wdt, ink); break;
+    case DcSquare:
+        Segment(c, cx - 9 * k, cy - 9 * k, cx + 9 * k, cy - 9 * k, wdt, ink);
+        Segment(c, cx + 9 * k, cy - 9 * k, cx + 9 * k, cy + 9 * k, wdt, ink);
+        Segment(c, cx + 9 * k, cy + 9 * k, cx - 9 * k, cy + 9 * k, wdt, ink);
+        Segment(c, cx - 9 * k, cy + 9 * k, cx - 9 * k, cy - 9 * k, wdt, ink);
+        break;
+    default: {  // triangle
+        const float top = cy - 10.5f * k, base = cy + 7.5f * k, half = 10.5f * k;
+        Segment(c, cx, top, cx + half, base, wdt, ink);
+        Segment(c, cx + half, base, cx - half, base, wdt, ink);
+        Segment(c, cx - half, base, cx, top, wdt, ink);
+        break;
+    }
+    }
+}
+
+/// The DualSense touchpad: a wide dark pad with a light outline.
+void Touchpad(DcCanvas& c) {
+    const float x0 = 4, x1 = c.w - 4.0f, h = std::min(c.h - 8.0f, 30.0f), y0 = (c.h - h) / 2, y1 = y0 + h;
+    Rounded(c, x0, y0, x1, y1, 5, h * 0.45f, {232, 232, 236, 255}, {200, 200, 206, 255});
+    Rounded(c, x0 + 2.4f, y0 + 2.4f, x1 - 2.4f, y1 - 2.4f, 3, h * 0.45f - 2.4f, {44, 44, 48, 255}, {24, 24, 26, 255});
+}
+
+/// Back: a silver pill with its name, as the 360's prompts show it.
+void Back360(DcCanvas& c) {
+    const float h = std::min(c.h - 8.0f, 26.0f), y0 = (c.h - h) / 2, x0 = 3, x1 = c.w - 3.0f;
+    Rounded(c, x0, y0, x1, y0 + h, h / 2, h / 2, {70, 70, 74, 255}, {40, 40, 44, 255});
+    Rounded(c, x0 + 2, y0 + 2, x1 - 2, y0 + h - 2, h / 2 - 2, h / 2 - 2, {238, 238, 240, 255},
+            {168, 170, 176, 255});
+    DcText(c, "BACK", c.w / 2.0f, c.h / 2.0f + 0.5f, h * 0.58f, (x1 - x0) * 0.78f, kInk, false);
+}
+
+} // namespace
+
+std::vector<uint8_t> DrawDc(DcIcon icon, DcStyle style) {
+    static const char* const xbox_names[] = {"LB", "RB", "LT", "RT"};
+    static const char* const ps_names[] = {"L1", "R1", "L2", "R2"};
+    const auto& t = DcTextures[icon];
+    DcCanvas c(t.width, t.height);
+    switch (icon) {
+    case DcCross: case DcCircle: case DcSquare: case DcTriangle: {
+        static const char* const letters[] = {"A", "B", "X", "Y"};
+        static const Color light[] = {{120, 200, 60, 255}, {236, 74, 60, 255}, {70, 140, 236, 255}, {250, 206, 60, 255}};
+        static const Color dark[] = {{40, 120, 20, 255}, {150, 20, 16, 255}, {16, 64, 160, 255}, {196, 132, 8, 255}};
+        if (style == DcXbox360) Gem(c, letters[icon], light[icon], dark[icon]);
+        else if (style == DcXboxOne) FlatFace(c, letters[icon], light[icon]);
+        else PsFace(c, icon);
+        break;
+    }
+    case DcL1: case DcR1: case DcL2: case DcR2: {
+        const int i = icon - DcL1;
+        const bool trigger = icon == DcL2 || icon == DcR2;
+        if (style == DcXbox360) Shoulder360(c, xbox_names[i], trigger);
+        else DarkShoulder(c, style == DcPs5 ? ps_names[i] : xbox_names[i], trigger);
+        break;
+    }
+    case DcL3: case DcR3: {
+        const bool left = icon == DcL3;
+        if (style == DcXbox360) Stick360(c, left ? "LS" : "RS");
+        else DarkStick(c, style == DcPs5 ? (left ? "L3" : "R3") : (left ? "LS" : "RS"));
+        break;
+    }
+    case DcTouchpad: case DcTouchpadSmall:
+        if (style == DcXbox360) Back360(c);
+        else if (style == DcXboxOne) View(c);
+        else Touchpad(c);
+        break;
+    default: break;
+    }
+    std::vector<uint8_t> out(size_t(t.width) * t.height * 4);
+    for (size_t i = 0; i < c.px.size(); ++i) {
+        const float a = c.px[i][3];
+        for (int k = 0; k < 3; ++k) {
+            // Straight colour; fully transparent pixels take a dark grey so filtering at the
+            // edges does not bleed a bright fringe.
+            const float v = a > 0.5f ? c.px[i][k] * 255.0f / a : 20.0f;
+            out[i * 4 + k] = uint8_t(std::clamp(std::lround(v), 0l, 255l));
+        }
+        out[i * 4 + 3] = uint8_t(std::clamp(std::lround(a), 0l, 255l));
+    }
+    return out;
+}
+
+std::vector<uint8_t> EncodeDc(DcIcon icon, const std::vector<uint8_t>& rgba, const std::vector<uint8_t>& original) {
+    const auto& t = DcTextures[icon];
+    std::vector<uint8_t> out = original;
+    out.resize(DcBytes(icon));
+    const int pitch = (t.width + 31) / 32 * 32;
+    for (int by = 0; by < t.height / 4; ++by) {
+        for (int bx = 0; bx < t.width / 4; ++bx) {
+            EncodeBlock(rgba.data(), t.width, bx, by, &out[TiledBlockOffset(bx, by, pitch)]);
+        }
+    }
+    return out;
+}
+
 } // namespace BbPromptIcons
