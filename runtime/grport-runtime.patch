-        LOG_WARNING(Render_Vulkan, "Unimplemented depth overlap copy");
+        static std::atomic<int> reported{0};
+        if (reported.fetch_add(1) < 8) {
+            LOG_WARNING(Render_Vulkan,
+                        "Unimplemented depth overlap copy: {} depth={} samples={} -> {} depth={} samples={}",
+                        vk::to_string(src->info.pixel_format), bool(src->info.props.is_depth),
+                        src->info.num_samples, vk::to_string(dst->info.pixel_format),
+                        bool(dst->info.props.is_depth), dst->info.num_samples);
+        }
