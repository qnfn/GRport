@@ -0,0 +1,96 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: adapted from GR2fork (github.com/junminlee2004/GR2fork, commit 124096c4).
+
+#include <cstring>
+#include <memory>
+#include <span>
+#include <thread>
+#include "video_core/amdgpu/liverpool.h"
+#include "video_core/renderer_vulkan/vk_presenter.h"
+#include "video_core/renderer_vulkan/vk_rasterizer.h"
+#include "video_core/renderer_vulkan/vk_runtime.h"
+#include "video_core/texture_cache/photo_readback.h"
+#include "video_core/texture_cache/texture_cache.h"
+
+extern std::unique_ptr<Vulkan::Presenter> presenter;
+extern std::unique_ptr<AmdGpu::Liverpool> liverpool;
+
+namespace VideoCore {
+
+bool PhotoReadback::Download(void* out, u32 pitch, u32 height) {
+    // SendCommand would wait on itself on the GPU command thread.
+    if (!presenter || !liverpool ||
+        liverpool->GetGpuCommandProcessorThread() == std::this_thread::get_id()) {
+        return false;
+    }
+    bool downloaded = false;
+    liverpool->SendCommand<true>([&] { downloaded = DownloadOnGpuThread(out, pitch, height); });
+    return downloaded;
+}
+
+bool PhotoReadback::DownloadOnGpuThread(void* out, u32 pitch, u32 height) {
+    Vulkan::Rasterizer& rasterizer = presenter->GetRasterizer();
+    TextureCache& texture_cache = rasterizer.GetTextureCache();
+    Vulkan::Runtime& runtime = rasterizer.GetRuntime();
+    // The photo's draws may still be queued; they go before the copy.
+    rasterizer.Finish();
+    const ImageId image_id{tracked_index.load(std::memory_order_relaxed)};
+    if (!image_id || !texture_cache.slot_images.IsAllocated(image_id)) {
+        LOG_WARNING(Render_Vulkan, "Photo: no photo target has been bound");
+        return false;
+    }
+    Image& image = texture_cache.slot_images[image_id];
+    const ImageInfo& info = image.info;
+    const u32 pitch_bytes = info.pitch * (info.num_bits / 8);
+    LOG_INFO(Render_Vulkan, "Photo target {:#x}: {}x{}, pitch {}, {} bits, {} layers", info.guest_address,
+             info.size.width, info.size.height, info.pitch, info.num_bits, info.resources.layers);
+    if (False(image.flags & ImageFlagBits::Registered) || !image.backing ||
+        False(image.flags & ImageFlagBits::GpuModified) ||
+        !IsArmed(info.size.width, info.size.height) || info.num_samples > 1 ||
+        info.props.is_depth || info.props.is_block || info.size.depth != 1 ||
+        info.resources.layers != 1 || info.num_bits != 32) {
+        LOG_WARNING(Render_Vulkan, "Photo: the photo target is not readable");
+        return false;
+    }
+    // Rows of another length hold pixels of another size, which the encoder would misread.
+    if (pitch_bytes != pitch) {
+        LOG_WARNING(Render_Vulkan, "Photo: target rows are {} bytes, the encoder's {}", pitch_bytes,
+                    pitch);
+        return false;
+    }
+    const u32 rows = std::min(info.size.height, height);
+    const u64 size = u64{pitch_bytes} * rows;
+    if (size == 0 || size > 64_MB) {
+        return false;
+    }
+    const auto download = runtime.GetStagingPool().Request(size, MemoryType::HostCached, 16);
+    const vk::BufferImageCopy copy = {
+        .bufferOffset = download.offset,
+        .bufferRowLength = info.pitch,
+        .bufferImageHeight = rows,
+        .imageSubresource{
+            .aspectMask = vk::ImageAspectFlagBits::eColor,
+            .mipLevel = 0,
+            .baseArrayLayer = 0,
+            .layerCount = 1,
+        },
+        .imageOffset = {0, 0, 0},
+        .imageExtent = {info.size.width, rows, 1},
+    };
+    runtime.DownloadImage(&image, download.buffer, std::span{&copy, 1});
+    rasterizer.Finish();
+    download.Invalidate();
+    std::memcpy(out, download.mapped, size);
+    return true;
+}
+
+} // namespace VideoCore
+
+extern "C" void bbgpu_photo_arm(uint32_t width, uint32_t height) {
+    VideoCore::PhotoReadback::Arm(width, height);
+}
+
+extern "C" int bbgpu_photo_download(void* out, uint32_t pitch, uint32_t height) {
+    return VideoCore::PhotoReadback::Download(out, pitch, height) ? 1 : 0;
+}
