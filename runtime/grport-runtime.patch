+    if (!save_list_active || menu_open) {
+        return false;
+    }
+    switch (event.type) {
+    case SDL_EVENT_KEY_DOWN:
+        switch (event.key.key) {
+        case SDLK_UP:
+        case SDLK_W:
+            MoveSaveSelection(-1);
+            break;
+        case SDLK_DOWN:
+        case SDLK_S:
+            MoveSaveSelection(1);
+            break;
+        case SDLK_PAGEUP:
+            MoveSaveSelection(-5);
+            break;
+        case SDLK_PAGEDOWN:
+            MoveSaveSelection(5);
+            break;
+        case SDLK_RETURN:
+        case SDLK_KP_ENTER:
+        case SDLK_SPACE:
+            if (!event.key.repeat) {
+                FinishSaveList(1);
+            }
+            break;
+        case SDLK_ESCAPE:
+        case SDLK_BACKSPACE:
+            if (!event.key.repeat && save_can_back) {
+                FinishSaveList(2);
+            }
+            break;
+        case SDLK_INSERT:
+            return false; // the settings menu still opens
+        default:
+            break;
+        }
+        return true;
+    case SDL_EVENT_KEY_UP:
+    case SDL_EVENT_TEXT_INPUT:
+        return true;
+    case SDL_EVENT_GAMEPAD_BUTTON_DOWN:
+    case SDL_EVENT_GAMEPAD_BUTTON_UP: {
+        const u8 button = event.gbutton.button;
+        if (button == SDL_GAMEPAD_BUTTON_LEFT_STICK || button == SDL_GAMEPAD_BUTTON_RIGHT_STICK) {
+            return false; // L3+R3 opens the settings menu
+        }
+        if (event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+            switch (button) {
+            case SDL_GAMEPAD_BUTTON_DPAD_UP:
+                MoveSaveSelection(-1);
+                break;
+            case SDL_GAMEPAD_BUTTON_DPAD_DOWN:
+                MoveSaveSelection(1);
+                break;
+            case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER:
+                MoveSaveSelection(-5);
+                break;
+            case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER:
+                MoveSaveSelection(5);
+                break;
+            case SDL_GAMEPAD_BUTTON_SOUTH:
+                FinishSaveList(1);
+                break;
+            case SDL_GAMEPAD_BUTTON_EAST:
+                if (save_can_back) {
+                    FinishSaveList(2);
+                }
+                break;
+            default:
+                break;
+            }
+        }
+        return true;
+    }
+    case SDL_EVENT_GAMEPAD_AXIS_MOTION:
+        if (event.gaxis.axis == SDL_GAMEPAD_AXIS_LEFTY) {
+            const int value = event.gaxis.value;
+            const int direction = value < -16000 ? -1 : value > 16000 ? 1 : 0;
+            if (direction != save_stick && (direction != 0 || std::abs(value) < 8000)) {
+                save_stick = direction;
