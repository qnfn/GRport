-        return ORBIS_VIDEO_OUT_ERROR_INVALID_VALUE;
-    }
-
-    if (attribute->reserved0 != 0 || attribute->reserved1 != 0) {
-        LOG_ERROR(Lib_VideoOut, "Invalid reserved members");
-        return ORBIS_VIDEO_OUT_ERROR_INVALID_VALUE;
-    }
-    if (attribute->aspect_ratio != 0) {
