+                        "stream-buffer %.1f %.1f\n",
+                        BbStats::site_wait_ns[0].exchange(0) / (window * 1e6),
+                        frames ? double(BbStats::site_waits[0].exchange(0)) / frames : 0.0,
+                        BbStats::site_wait_ns[1].exchange(0) / (window * 1e6),
+                        frames ? double(BbStats::site_waits[1].exchange(0)) / frames : 0.0,
+                        BbStats::site_wait_ns[2].exchange(0) / (window * 1e6),
+                        frames ? double(BbStats::site_waits[2].exchange(0)) / frames : 0.0,
+                        BbStats::site_wait_ns[3].exchange(0) / (window * 1e6),
+                        frames ? double(BbStats::site_waits[3].exchange(0)) / frames : 0.0,
+                        BbStats::site_wait_ns[4].exchange(0) / (window * 1e6),
+                        frames ? double(BbStats::site_waits[4].exchange(0)) / frames : 0.0);
+            std::printf("Async readback per frame: ranges <=256B %.1f, <=4K %.1f, <=64K %.1f, "
+                        "larger %.1f; %.1f KiB\n",
+                        frames ? double(BbStats::async_ranges[0].exchange(0)) / frames : 0.0,
+                        frames ? double(BbStats::async_ranges[1].exchange(0)) / frames : 0.0,
+                        frames ? double(BbStats::async_ranges[2].exchange(0)) / frames : 0.0,
+                        frames ? double(BbStats::async_ranges[3].exchange(0)) / frames : 0.0,
+                        frames ? double(BbStats::async_bytes.exchange(0)) / frames / 1024.0 : 0.0);
+            // Frame pacing: spread of the guest flip intervals (judder that the mean hides).
+            if (intervals.size() > 2) {
+                std::vector<double> sorted = intervals;
+                std::sort(sorted.begin(), sorted.end());
+                const double median = sorted[sorted.size() / 2];
+                double sum = 0, sq = 0;
+                u32 spikes = 0;
+                for (const double ms : intervals) {
+                    sum += ms;
+                    sq += ms * ms;
+                    spikes += ms > 1.5 * median;
+                }
+                const double mean = sum / intervals.size();
