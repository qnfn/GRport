-    u8 regs_reset;
-    u16 num_blocks;
-    u32 num_stages;
-    u32 verify;
-    std::array<AmdGpu::CbDbExtent, AmdGpu::NUM_COLOR_BUFFERS> cb_extent;
-    AmdGpu::CbDbExtent db_extent;
