diff --git a/src/runtime_font.c b/src/runtime_font.c
new file mode 100644
index 0000000..62bea4f
--- /dev/null
+++ b/src/runtime_font.c
@@ -0,0 +1,329 @@
+/* libSceFont on FreeType (Driveclub).
+ *
+ * The game opens its own TrueType/OpenType fonts from memory, sets a pixel scale and
+ * rasterizes glyphs one at a time into an 8-bit render surface (its glyph cache), each at a
+ * pen position on the baseline. FreeType rasterizes; this file maps the API onto it. Structure
+ * layouts and placement follow BlackLineInteractive/Driveclub-Port's CoreText version
+ * (GPL-2.0-or-later). The PS4 system font set has no files here: a Windows font stands in. */
+#define _GNU_SOURCE
+#include <math.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ft2build.h>
+#include FT_FREETYPE_H
+#include "runtime.h"
+
+#define FONT_ERROR_INVALID_PARAMETER ((int32_t)0x80460002)
+#define FONT_ERROR_NO_SUPPORT_GLYPH ((int32_t)0x80460010)
+#define FONT_ERROR_NO_SUPPORT_FONTSET ((int32_t)0x80460019)
+
+typedef struct {
+    float width, height;
+    struct { float bearing_x, bearing_y, advance; } horizontal, vertical;
+} GlyphMetrics;
+_Static_assert(sizeof(GlyphMetrics) == 32, "SceFontGlyphMetrics");
+
+typedef struct { float baseline_offset, line_advance, decoration_extent; } HorizontalLayout;
+typedef struct { float offset_x, offset_y, position_x, position_y; } Kerning;
+
+typedef struct {
+    uint8_t *buffer;
+    int32_t width_byte;
+    int8_t pixel_size_byte;
+    uint8_t pad0, style_flag, pad2;
+    int32_t width, height;
+    uint32_t sc_x0, sc_y0, sc_x1, sc_y1;
+    uint64_t reserved[11];
+} RenderSurface;
+_Static_assert(sizeof(RenderSurface) == 128, "SceFontRenderSurface");
+
+typedef struct {
+    const void *stage;
+    struct { uint8_t *address; uint32_t width_byte; uint8_t pixel_size_byte, pixel_format; uint16_t pad; } surface_image;
+    struct { uint32_t x, y, w, h; } update_rect;
+    struct { float bearing_x, bearing_y, advance, stride; uint32_t width, height; } image_metrics;
+} RenderOutput;
+_Static_assert(sizeof(RenderOutput) == 64, "SceFontRenderOutput");
+
+typedef struct {
+    FT_Face face;
+    void *data;  /* FreeType reads the font from here for as long as the face lives */
+    float scale_w, scale_h, sized_w, sized_h;
+} Font;
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static FT_Library library;
+static _Alignas(64) uint8_t guest_library[256], guest_renderer[256];
+static unsigned fonts_opened, glyphs_rendered;
+
+static int ensure_library(void) {
+    return library || !FT_Init_FreeType(&library);
+}
+
+static void apply_scale(Font *f) {
+    if (f->sized_w == f->scale_w && f->sized_h == f->scale_h) return;
+    FT_Set_Char_Size(f->face, (FT_F26Dot6)lroundf(f->scale_w * 64.0f), (FT_F26Dot6)lroundf(f->scale_h * 64.0f), 72, 72);
+    f->sized_w = f->scale_w;
+    f->sized_h = f->scale_h;
+}
+
+/* Loads `code` at the current scale with an optional fractional pen offset (pixels, y down). */
+static int load_glyph(Font *f, uint32_t code, float fx, float fy, int render) {
+    FT_UInt index = FT_Get_Char_Index(f->face, code);
+    if (!index) return 0;
+    apply_scale(f);
+    FT_Vector delta = {(FT_Pos)lroundf(fx * 64.0f), (FT_Pos)lroundf(-fy * 64.0f)};
+    FT_Set_Transform(f->face, NULL, render ? &delta : NULL);
+    if (FT_Load_Glyph(f->face, index, FT_LOAD_NO_HINTING | FT_LOAD_NO_BITMAP)) return 0;
+    if (render && FT_Render_Glyph(f->face->glyph, FT_RENDER_MODE_NORMAL)) return 0;
+    return 1;
+}
+
+/* Metrics in pixels; y up from the baseline, as the API reports them. */
+static void metrics(const Font *f, GlyphMetrics *m) {
+    const FT_Glyph_Metrics *g = &f->face->glyph->metrics;
+    memset(m, 0, sizeof(*m));
+    m->width = g->width / 64.0f;
+    m->height = g->height / 64.0f;
+    m->horizontal.bearing_x = g->horiBearingX / 64.0f;
+    m->horizontal.bearing_y = g->horiBearingY / 64.0f;
+    m->horizontal.advance = g->horiAdvance / 64.0f;
+    m->vertical.bearing_x = g->vertBearingX / 64.0f;
+    m->vertical.bearing_y = g->vertBearingY / 64.0f;
+    m->vertical.advance = g->vertAdvance / 64.0f;
+}
+
+static Font *open_font(const void *data, size_t size, const char *what) {
+    if (!ensure_library()) return NULL;
+    Font *f = calloc(1, sizeof(*f));
+    if (!f || !(f->data = malloc(size))) { free(f); return NULL; }
+    memcpy(f->data, data, size);
+    if (FT_New_Memory_Face(library, f->data, (FT_Long)size, 0, &f->face)) {
+        free(f->data);
+        free(f);
+        return NULL;
+    }
+    f->scale_w = f->scale_h = 16.0f;
+    ++fonts_opened;
+    printf("Font: opened %s %s (%zu bytes)\n", what, f->face->family_name ? f->face->family_name : "?", size);
+    return f;
+}
+
+static ABI int32_t font_ok(void) { return 0; }
+
+static ABI int32_t create_library(const void *mem, const void *params, uint64_t edition, void **out) {
+    (void)mem, (void)params, (void)edition;
+    if (!out) return FONT_ERROR_INVALID_PARAMETER;
+    *out = guest_library;
+    return 0;
+}
+static ABI int32_t create_renderer(const void *mem, const void *params, uint64_t edition, void **out) {
+    (void)mem, (void)params, (void)edition;
+    if (!out) return FONT_ERROR_INVALID_PARAMETER;
+    *out = guest_renderer;
+    return 0;
+}
+static ABI int32_t destroy_handle(void **handle) {
+    if (handle) *handle = NULL;
+    return 0;
+}
+
+static ABI int32_t open_font_memory(void *lib, const void *data, uint32_t size, const void *params, Font **out) {
+    (void)lib, (void)params;
+    if (!data || !size || !out) return FONT_ERROR_INVALID_PARAMETER;
+    pthread_mutex_lock(&lock);
+    Font *f = open_font(data, size, "game font");
+    pthread_mutex_unlock(&lock);
+    if (!f) {
+        printf("Font: cannot open a %u-byte font\n", size);
+        return FONT_ERROR_INVALID_PARAMETER;
+    }
+    *out = f;
+    return 0;
+}
+
+/* System font sets: the closest Windows font. */
+static ABI int32_t open_font_set(void *lib, uint32_t type, uint32_t mode, const void *params, Font **out) {
+    (void)lib, (void)mode, (void)params;
+    if (!out) return FONT_ERROR_INVALID_PARAMETER;
+    static const char *const candidates[] = {"C:\\Windows\\Fonts\\segoeui.ttf", "C:\\Windows\\Fonts\\arial.ttf"};
+    for (size_t i = 0; i < sizeof(candidates) / sizeof(*candidates); ++i) {
+        FILE *file = fopen(candidates[i], "rb");
+        if (!file) continue;
+        fseek(file, 0, SEEK_END);
+        long size = ftell(file);
+        fseek(file, 0, SEEK_SET);
+        void *data = size > 0 ? malloc((size_t)size) : NULL;
+        size_t read = data ? fread(data, 1, (size_t)size, file) : 0;
+        fclose(file);
+        if (read == (size_t)size && data) {
+            pthread_mutex_lock(&lock);
+            Font *f = open_font(data, read, "system font set");
+            pthread_mutex_unlock(&lock);
+            free(data);
+            if (f) {
+                printf("Font: system font set 0x%x -> %s\n", type, candidates[i]);
+                *out = f;
+                return 0;
+            }
+        } else {
+            free(data);
+        }
+    }
+    return FONT_ERROR_NO_SUPPORT_FONTSET;
+}
+
+static ABI int32_t close_font(Font *f) {
+    pthread_mutex_lock(&lock);
+    if (f) {
+        FT_Done_Face(f->face);
+        free(f->data);
+        free(f);
+    }
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static ABI int32_t set_scale_pixel(Font *f, float w, float h) {
+    if (!f || w <= 0.0f || h <= 0.0f) return FONT_ERROR_INVALID_PARAMETER;
+    pthread_mutex_lock(&lock);
+    f->scale_w = w;
+    f->scale_h = h;
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+/* The size set_scale_pixel gave the font; Gravity Rush sizes its text textures from it
+   (with 0 x 0 every glyph is empty and no text appears). */
+static ABI int32_t get_scale_pixel(Font *f, float *w, float *h) {
+    if (!f) {
+        if (w) *w = 0.0f;
+        if (h) *h = 0.0f;
+        return FONT_ERROR_INVALID_PARAMETER;
+    }
+    pthread_mutex_lock(&lock);
+    if (w) *w = f->scale_w;
+    if (h) *h = f->scale_h;
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static ABI int32_t horizontal_layout(Font *f, HorizontalLayout *layout) {
+    if (!f || !layout) return FONT_ERROR_INVALID_PARAMETER;
+    pthread_mutex_lock(&lock);
+    apply_scale(f);
+    const FT_Size_Metrics *s = &f->face->size->metrics;
+    layout->baseline_offset = s->ascender / 64.0f;
+    layout->line_advance = s->height / 64.0f;
+    layout->decoration_extent = FT_MulFix(f->face->underline_thickness, s->y_scale) / 64.0f;
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static ABI int32_t glyph_metrics(Font *f, uint32_t code, GlyphMetrics *m) {
+    if (!f || !m) return FONT_ERROR_INVALID_PARAMETER;
+    pthread_mutex_lock(&lock);
+    int found = load_glyph(f, code, 0, 0, 0);
+    if (found) metrics(f, m); else memset(m, 0, sizeof(*m));
+    pthread_mutex_unlock(&lock);
+    return found ? 0 : FONT_ERROR_NO_SUPPORT_GLYPH;
+}
+
+static ABI int32_t kerning(Font *f, uint32_t pre, uint32_t code, Kerning *k) {
+    (void)f, (void)pre, (void)code;
+    if (k) memset(k, 0, sizeof(*k));
+    return 0;
+}
+
+static ABI void render_surface_init(RenderSurface *s, void *buffer, int32_t width_byte, int32_t pixel_size,
+                                    int32_t width, int32_t height) {
+    if (!s) return;
+    memset(s, 0, sizeof(*s));
+    s->buffer = buffer;
+    s->width_byte = width_byte;
+    s->pixel_size_byte = (int8_t)pixel_size;
+    s->width = width > 0 ? width : 0;
+    s->height = height > 0 ? height : 0;
+    s->sc_x1 = (uint32_t)s->width;
+    s->sc_y1 = (uint32_t)s->height;
+}
+
+static int32_t max_i(int32_t a, int32_t b) { return a > b ? a : b; }
+static int32_t min_i(int32_t a, int32_t b) { return a < b ? a : b; }
+
+/* Rasterizes `code` with its pen position at (x, y) (y down, on the baseline) into the
+ * surface, as coverage. */
+static ABI int32_t render_glyph(Font *f, uint32_t code, RenderSurface *s, float x, float y, GlyphMetrics *m,
+                                RenderOutput *out) {
+    if (!f || !s || !m || !out) return FONT_ERROR_INVALID_PARAMETER;
+    pthread_mutex_lock(&lock);
+    const float fx = x - floorf(x), fy = y - floorf(y);
+    if (!load_glyph(f, code, 0, 0, 0)) {
+        memset(m, 0, sizeof(*m));
+        memset(out, 0, sizeof(*out));
+        pthread_mutex_unlock(&lock);
+        return FONT_ERROR_NO_SUPPORT_GLYPH;
+    }
+    metrics(f, m);
+    load_glyph(f, code, fx, fy, 1);
+    const FT_GlyphSlot slot = f->face->glyph;
+    const FT_Bitmap *bitmap = &slot->bitmap;
+    const int32_t left = slot->bitmap_left, top = slot->bitmap_top;
+    const int32_t gw = (int32_t)bitmap->width, gh = (int32_t)bitmap->rows;
+    const int32_t right = left + gw;
+    const int32_t dest_x = (int32_t)floorf(x) + left, dest_y = (int32_t)floorf(y) - top;
+    const int32_t bpp = s->pixel_size_byte > 0 ? s->pixel_size_byte : 1;
+    int32_t ux0 = dest_x, uy0 = dest_y, uw = 0, uh = 0;
+    if (gw > 0 && gh > 0 && s->buffer && bitmap->buffer) {
+        const int32_t x0 = max_i(dest_x, (int32_t)s->sc_x0), x1 = min_i(dest_x + gw, (int32_t)s->sc_x1);
+        const int32_t y0 = max_i(dest_y, (int32_t)s->sc_y0), y1 = min_i(dest_y + gh, (int32_t)s->sc_y1);
+        if (x1 > x0 && y1 > y0) {
+            for (int32_t row = y0; row < y1; ++row) {
+                const uint8_t *src = bitmap->buffer + (ptrdiff_t)(row - dest_y) * bitmap->pitch;
+                uint8_t *dst = s->buffer + (size_t)row * (size_t)s->width_byte;
+                for (int32_t col = x0; col < x1; ++col)
+                    memset(dst + (size_t)col * (size_t)bpp, src[col - dest_x], (size_t)bpp);
+            }
+            ux0 = x0, uy0 = y0, uw = x1 - x0, uh = y1 - y0;
+        }
+    }
+    ++glyphs_rendered;
+    memset(out, 0, sizeof(*out));
+    out->update_rect.x = (uint32_t)max_i(ux0, 0);
+    out->update_rect.y = (uint32_t)max_i(uy0, 0);
+    out->update_rect.w = (uint32_t)uw;
+    out->update_rect.h = (uint32_t)uh;
+    out->surface_image.address = s->buffer ? s->buffer + (size_t)out->update_rect.y * (size_t)s->width_byte +
+                                             (size_t)out->update_rect.x * (size_t)bpp : NULL;
+    out->surface_image.width_byte = (uint32_t)s->width_byte;
+    out->surface_image.pixel_size_byte = (uint8_t)bpp;
+    const float advance_end = ceilf(x + m->horizontal.advance);
+    out->image_metrics.bearing_x = (float)((int32_t)floorf(x) + left) - x;
+    out->image_metrics.bearing_y = (float)top + floorf(y) - y;
+    out->image_metrics.advance = advance_end - x;
+    out->image_metrics.stride = fmaxf(advance_end, floorf(x) + (float)right) - x;
+    out->image_metrics.width = (uint32_t)gw;
+    out->image_metrics.height = (uint32_t)gh;
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+static const RuntimeExport exports[] = {
+    {"sceFontMemoryInit", font_ok}, {"sceFontCreateLibraryWithEdition", create_library},
+    {"sceFontCreateRendererWithEdition", create_renderer}, {"sceFontDestroyLibrary", destroy_handle},
+    {"sceFontDestroyRenderer", destroy_handle}, {"sceFontAttachDeviceCacheBuffer", font_ok},
+    {"sceFontSupportExternalFonts", font_ok}, {"sceFontSupportSystemFonts", font_ok},
+    {"sceFontSelectLibraryFt", font_ok}, {"sceFontSelectRendererFt", font_ok},
+    {"sceFontOpenFontMemory", open_font_memory}, {"sceFontOpenFontSet", open_font_set},
+    {"sceFontCloseFont", close_font}, {"sceFontBindRenderer", font_ok}, {"sceFontUnbindRenderer", font_ok},
+    {"sceFontSetScalePixel", set_scale_pixel}, {"sceFontSetupRenderScalePixel", set_scale_pixel},
+    {"sceFontGetScalePixel", get_scale_pixel}, {"sceFontGetRenderScalePixel", get_scale_pixel},
+    {"sceFontGetHorizontalLayout", horizontal_layout}, {"sceFontGetCharGlyphMetrics", glyph_metrics},
+    {"sceFontGetKerning", kerning}, {"sceFontRenderSurfaceInit", render_surface_init},
+    {"sceFontRenderCharGlyphImage", render_glyph}, {"sceFontRenderCharGlyphImageHorizontal", render_glyph},
+};
+
+uintptr_t runtime_font_resolve(const char *name) { return RUNTIME_LOOKUP(exports, name); }
diff --git a/src/runtime_image.c b/src/runtime_image.c
new file mode 100644
index 0000000..d622e84
--- /dev/null
+++ b/src/runtime_image.c
@@ -0,0 +1,481 @@
+/* libSceJpegEnc, libSceJpegDec and libScePngDec on stb_image / stb_image_write.
+ *
+ * Gravity Rush 2's photo mode encodes each photo with sceJpegEncEncode and shows the
+ * Camera Roll from sceJpegDecDecode; without these the photo is never written and its
+ * thumbnail is the game's red "no image" square. Parameter checks follow shadPS4's
+ * (reverse-engineered) libraries: src/core/libraries/jpeg and libpng. */
+#include "runtime.h"
+#include "gpu/bbgpu.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Weverything"
+#define STBI_ONLY_JPEG
+#define STBI_ONLY_PNG
+#define STBI_NO_STDIO
+#define STB_IMAGE_IMPLEMENTATION
+#include "third_party/stb/stb_image.h"
+#define STBI_WRITE_NO_STDIO
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "third_party/stb/stb_image_write.h"
+#pragma clang diagnostic pop
+
+#define JPEG_DEC_INVALID_ADDR ((int32_t)0x80650001)
+#define JPEG_DEC_INVALID_SIZE ((int32_t)0x80650002)
+#define JPEG_DEC_INVALID_PARAM ((int32_t)0x80650003)
+#define JPEG_DEC_INVALID_HANDLE ((int32_t)0x80650004)
+#define JPEG_DEC_EXCEED_MAX_WIDTH ((int32_t)0x80650006)
+#define JPEG_DEC_INVALID_DATA ((int32_t)0x80650010)
+#define JPEG_DEC_DECODE_ERROR ((int32_t)0x80650012)
+#define JPEG_ENC_INVALID_ADDR ((int32_t)0x80650101)
+#define JPEG_ENC_INVALID_SIZE ((int32_t)0x80650102)
+#define JPEG_ENC_INVALID_PARAM ((int32_t)0x80650103)
+#define JPEG_ENC_INVALID_HANDLE ((int32_t)0x80650104)
+#define PNG_DEC_INVALID_ADDR ((int32_t)0x80690001)
+#define PNG_DEC_INVALID_SIZE ((int32_t)0x80690002)
+#define PNG_DEC_INVALID_PARAM ((int32_t)0x80690003)
+#define PNG_DEC_INVALID_HANDLE ((int32_t)0x80690004)
+#define PNG_DEC_INVALID_DATA ((int32_t)0x80690010)
+#define PNG_DEC_DECODE_ERROR ((int32_t)0x80690012)
+
+static int aligned(uintptr_t v, uintptr_t a) { return (v & (a - 1)) == 0; }
+static uintptr_t align_up(uintptr_t v, uintptr_t a) { return (v + a - 1) & ~(a - 1); }
+static int first_time(int *flag) { return __atomic_exchange_n(flag, 1, __ATOMIC_RELAXED) == 0; }
+
+/* Writes a decoded RGBA8 pixel as the guest asked: RGBA/BGRA (alpha forced unless 0) or Y8. */
+static void store_pixel(uint8_t *dst, const uint8_t *rgba, int bgra, int y8, uint16_t alpha) {
+    if (y8) { dst[0] = (uint8_t)((rgba[0] * 77 + rgba[1] * 150 + rgba[2] * 29) >> 8); return; }
+    dst[0] = rgba[bgra ? 2 : 0]; dst[1] = rgba[1]; dst[2] = rgba[bgra ? 0 : 2];
+    dst[3] = alpha ? (uint8_t)alpha : rgba[3];
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* libSceJpegEnc                                                                              */
+
+typedef struct JpegEncHandle { struct JpegEncHandle *self; uint32_t size; } JpegEncHandle;
+typedef struct { uint32_t size, attr; } JpegEncCreateParam;
+typedef struct {
+    const void *image; void *jpeg;
+    uint32_t image_size, jpeg_size, image_width, image_height, image_pitch;
+    uint16_t pixel_format, encode_mode, color_space;
+    uint8_t sampling_type, compression_ratio;
+    int32_t restart_interval;
+} JpegEncEncodeParam;
+typedef struct { uint32_t size, height; } JpegEncOutputInfo;
+_Static_assert(sizeof(JpegEncEncodeParam) == 0x30, "SceJpegEncEncodeParam layout");
+
+enum { ENC_RGBA = 0, ENC_BGRA = 1, ENC_YUYV = 10, ENC_Y8 = 11 };
+enum { ENC_YCC = 1, ENC_GRAY = 2 };
+enum { ENC_FULL = 0, ENC_422 = 1, ENC_420 = 2 };
+#define JPEG_ENC_MIN_MEMORY 0x800
+
+static ABI int32_t jpeg_enc_query_memory(const JpegEncCreateParam *p) {
+    if (!p) return JPEG_ENC_INVALID_ADDR;
+    if (p->size != sizeof(*p)) return JPEG_ENC_INVALID_SIZE;
+    if (p->attr != 0) return JPEG_ENC_INVALID_PARAM;
+    return JPEG_ENC_MIN_MEMORY;
+}
+
+static ABI int32_t jpeg_enc_create(const JpegEncCreateParam *p, void *memory, uint32_t size,
+                                   JpegEncHandle **handle) {
+    int32_t r = jpeg_enc_query_memory(p);
+    if (r < 0) return r;
+    if (!memory) return JPEG_ENC_INVALID_ADDR;
+    if (size < JPEG_ENC_MIN_MEMORY) return JPEG_ENC_INVALID_SIZE;
+    if (!handle) return JPEG_ENC_INVALID_ADDR;
+    JpegEncHandle *h = (JpegEncHandle *)align_up((uintptr_t)memory, 0x20);
+    h->self = h; h->size = sizeof(void *);
+    *handle = h;
+    return 0;
+}
+
+static int jpeg_enc_valid(const JpegEncHandle *h) {
+    return h && aligned((uintptr_t)h, 0x20) && h->self == h;
+}
+
+static ABI int32_t jpeg_enc_delete(JpegEncHandle *h) {
+    if (!jpeg_enc_valid(h)) return JPEG_ENC_INVALID_HANDLE;
+    h->self = NULL;
+    return 0;
+}
+
+static int32_t jpeg_enc_check(const JpegEncEncodeParam *p) {
+    if (!p) return JPEG_ENC_INVALID_ADDR;
+    if (!p->image || (p->pixel_format != ENC_Y8 && !aligned((uintptr_t)p->image, 4)) || !p->jpeg)
+        return JPEG_ENC_INVALID_ADDR;
+    if (!p->image_size || !p->jpeg_size) return JPEG_ENC_INVALID_SIZE;
+    if (!p->image_width || !p->image_height || p->image_width > 0xFFFF || p->image_height > 0xFFFF)
+        return JPEG_ENC_INVALID_PARAM;
+    if (!p->image_pitch || p->image_pitch > 0xFFFFFFF ||
+        (p->pixel_format != ENC_Y8 && !aligned(p->image_pitch, 4)))
+        return JPEG_ENC_INVALID_PARAM;
+    uint64_t need = (uint64_t)p->image_height * p->image_pitch;
+    if (need > 0x7FFFFFFF || need > p->image_size) return JPEG_ENC_INVALID_PARAM;
+    if (p->encode_mode > 1 || (p->color_space != ENC_YCC && p->color_space != ENC_GRAY) ||
+        p->sampling_type > ENC_420 || p->restart_interval > 0xFFFF)
+        return JPEG_ENC_INVALID_PARAM;
+    switch (p->pixel_format) {
+    case ENC_RGBA: case ENC_BGRA:
+        if (p->image_pitch / 4 < p->image_width || p->color_space != ENC_YCC || p->sampling_type == ENC_FULL)
+            return JPEG_ENC_INVALID_PARAM;
+        return 0;
+    case ENC_YUYV:
+        if (p->image_pitch / 2 < align_up(p->image_width, 2) || p->color_space != ENC_YCC ||
+            p->sampling_type == ENC_FULL)
+            return JPEG_ENC_INVALID_PARAM;
+        return 0;
+    case ENC_Y8:
+        if (p->image_pitch < p->image_width || p->color_space != ENC_GRAY || p->sampling_type != ENC_FULL)
+            return JPEG_ENC_INVALID_PARAM;
+        return 0;
+    default: return JPEG_ENC_INVALID_PARAM;
+    }
+}
+
+static uint8_t clamp8(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+/* The guest's rows as tightly packed RGB (or Y), which is what stb_image_write takes. */
+static uint8_t *jpeg_enc_pixels(const JpegEncEncodeParam *p, int *components) {
+    const uint32_t w = p->image_width, h = p->image_height;
+    const int gray = p->pixel_format == ENC_Y8;
+    *components = gray ? 1 : 3;
+    uint8_t *out = malloc((size_t)w * h * (size_t)*components);
+    if (!out) return NULL;
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t *row = (const uint8_t *)p->image + (size_t)y * p->image_pitch;
+        uint8_t *dst = out + (size_t)y * w * (size_t)*components;
+        if (gray) { memcpy(dst, row, w); continue; }
+        for (uint32_t x = 0; x < w; x++, dst += 3) {
+            if (p->pixel_format == ENC_YUYV) {
+                const uint8_t *pair = row + (x & ~1u) * 2;
+                int Y = pair[(x & 1) ? 2 : 0] - 16, U = pair[1] - 128, V = pair[3] - 128;
+                dst[0] = clamp8((298 * Y + 409 * V + 128) >> 8);
+                dst[1] = clamp8((298 * Y - 100 * U - 208 * V + 128) >> 8);
+                dst[2] = clamp8((298 * Y + 516 * U + 128) >> 8);
+            } else {
+                const uint8_t *s = row + x * 4;
+                int bgra = p->pixel_format == ENC_BGRA;
+                dst[0] = s[bgra ? 2 : 0]; dst[1] = s[1]; dst[2] = s[bgra ? 0 : 2];
+            }
+        }
+    }
+    return out;
+}
+
+typedef struct { uint8_t *data; uint32_t capacity, size; int overflow; } JpegSink;
+static void jpeg_sink(void *context, void *data, int size) {
+    JpegSink *s = context;
+    if (s->overflow || size < 0 || (uint64_t)s->size + (uint32_t)size > s->capacity) { s->overflow = 1; return; }
+    memcpy(s->data + s->size, data, (size_t)size);
+    s->size += (uint32_t)size;
+}
+
+/* compression_ratio: 0 and 1 are the best quality; larger values compress harder. */
+static int jpeg_quality(uint8_t ratio) {
+    int q = ratio <= 1 ? 95 : 100 - ratio;
+    return q < 40 ? 40 : q > 95 ? 95 : q;
+}
+
+static ABI int32_t jpeg_enc_encode(JpegEncHandle *h, const JpegEncEncodeParam *p, JpegEncOutputInfo *info) {
+    static int logged;
+    if (!jpeg_enc_valid(h)) return JPEG_ENC_INVALID_HANDLE;
+    int32_t r = jpeg_enc_check(p);
+    if (r < 0) {
+        printf("JpegEnc: encode rejected (%#x)\n", (unsigned)r);
+        return r;
+    }
+    /* Gravity Rush 2 copies its photo target from guest memory, which the GPU never wrote back,
+     * and encodes that copy: the target's own pixels take its place (from GR2fork). */
+    const int is_photo = runtime_photo_is_target(p->image_width, p->image_height);
+    if (is_photo && !bbgpu_photo_download((void *)p->image, p->image_pitch, p->image_height))
+        printf("JpegEnc: photo target not read back; encoding the game's copy\n");
+    int components;
+    uint8_t *pixels = jpeg_enc_pixels(p, &components);
+    if (!pixels) return JPEG_ENC_INVALID_SIZE;
+    JpegSink sink = {p->jpeg, p->jpeg_size, 0, 0};
+    int quality = jpeg_quality(p->compression_ratio);
+    /* The guest's buffer is fixed; step the quality down until the photo fits. */
+    for (;;) {
+        sink.size = 0; sink.overflow = 0;
+        int ok = stbi_write_jpg_to_func(jpeg_sink, &sink, (int)p->image_width, (int)p->image_height,
+                                        components, pixels, quality);
+        if (ok && !sink.overflow) break;
+        if (quality <= 10) { free(pixels); printf("JpegEnc: %ux%u does not fit in %u bytes\n",
+                                                   p->image_width, p->image_height, p->jpeg_size);
+            return JPEG_ENC_INVALID_SIZE; }
+        quality = quality > 30 ? quality - 15 : 10;
+    }
+    free(pixels);
+    if (first_time(&logged))
+        printf("JpegEnc: %ux%u format %u ratio %u -> %u bytes (quality %d, buffer %u)\n",
+               p->image_width, p->image_height, p->pixel_format, p->compression_ratio, sink.size,
+               quality, p->jpeg_size);
+    if (info) { info->size = sink.size; info->height = p->image_height; }
+    /* A photo that small is an empty frame, which is not kept (GR2fork's threshold). */
+    if (is_photo) {
+        if (sink.size < 30000) { printf("JpegEnc: photo of %u bytes looks empty; not saved\n", sink.size); runtime_photo_drop(); }
+        else runtime_photo_save(p->jpeg, sink.size);
+    }
+    /* The JPEG's size: Gravity Rush 2 treats a result that is not positive as a failed photo
+     * (as found by GR2fork, github.com/junminlee2004/GR2fork). */
+    return (int32_t)sink.size;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* libSceJpegDec                                                                              */
+
+typedef struct JpegDecHandle {
+    struct JpegDecHandle *self; uint32_t size, decode_mode, max_width, aux;
+} JpegDecHandle;
+typedef struct { uint32_t size, decode_mode, max_width; } JpegDecCreateParam;
+typedef struct { const void *jpeg; uint32_t jpeg_size; uint16_t decode_mode, downscale; } JpegDecParseParam;
+typedef struct {
+    uint32_t width, height; uint16_t color_space, components;
+    uint8_t component_id[4], sampling[4];
+    uint32_t decode_mode, required_decode_mode, output_width, output_height;
+} JpegDecImageInfo;
+typedef struct {
+    const void *jpeg; void *image; void *aux;
+    uint32_t jpeg_size, image_size, aux_size;
+    uint16_t decode_mode, downscale, pixel_format, alpha;
+    uint32_t image_pitch;
+} JpegDecDecodeParam;
+_Static_assert(sizeof(JpegDecImageInfo) == 0x24, "SceJpegDecImageInfo layout");
+_Static_assert(sizeof(JpegDecDecodeParam) == 0x30, "SceJpegDecDecodeParam layout");
+
+static int ratio_valid(uint32_t r) { return r == 1 || r == 2 || r == 4 || r == 8; }
+
+static ABI int32_t jpeg_dec_parse(const JpegDecParseParam *p, JpegDecImageInfo *info) {
+    if (!p || !p->jpeg) return JPEG_DEC_INVALID_ADDR;
+    if (!p->jpeg_size) return JPEG_DEC_INVALID_SIZE;
+    if (p->decode_mode > 1 || !ratio_valid(p->downscale)) return JPEG_DEC_INVALID_PARAM;
+    if (!info) return JPEG_DEC_INVALID_ADDR;
+    const uint8_t *b = p->jpeg;
+    const uint32_t n = p->jpeg_size;
+    if (n < 4 || b[0] != 0xFF || b[1] != 0xD8) return JPEG_DEC_INVALID_DATA;
+    uint32_t w = 0, h = 0, comps = 3;
+    uint8_t ids[4] = {1, 2, 3, 0}, sf[4] = {0x22, 0x11, 0x11, 0};
+    for (uint32_t pos = 2; pos + 4 < n;) {
+        if (b[pos] != 0xFF) { pos++; continue; }
+        uint8_t m = b[pos + 1];
+        if (m == 0xD9 || m == 0xDA) break;
+        if (m == 0xFF || m == 0x01 || (m >= 0xD0 && m <= 0xD7)) { pos += m == 0xFF ? 1 : 2; continue; }
+        uint32_t len = (uint32_t)b[pos + 2] << 8 | b[pos + 3];
+        if (m >= 0xC0 && m <= 0xC2 && pos + 9 < n) {
+            h = (uint32_t)b[pos + 5] << 8 | b[pos + 6];
+            w = (uint32_t)b[pos + 7] << 8 | b[pos + 8];
+            comps = b[pos + 9];
+            for (uint32_t c = 0; c < comps && c < 4 && pos + 11 + c * 3 < n; c++) {
+                ids[c] = b[pos + 10 + c * 3]; sf[c] = b[pos + 11 + c * 3];
+            }
+            break;
+        }
+        pos += 2 + len;
+    }
+    if (!w || !h) return JPEG_DEC_DECODE_ERROR;
+    memset(info, 0, sizeof(*info));
+    info->width = w; info->height = h;
+    info->color_space = comps == 1 ? 2 : comps == 3 ? 1 : 0;
+    info->components = (uint16_t)comps;
+    memcpy(info->component_id, ids, 4); memcpy(info->sampling, sf, 4);
+    info->decode_mode = p->decode_mode;
+    if (comps == 1) info->required_decode_mode = 1;
+    else if (comps == 3) {
+        uint32_t max_h = 1, density = 0;
+        for (int c = 0; c < 3; c++) {
+            if ((uint32_t)(sf[c] >> 4) > max_h) max_h = sf[c] >> 4;
+            density += (uint32_t)(sf[c] >> 4) * (sf[c] & 15);
+        }
+        info->required_decode_mode = density * (96 / (max_h * 8)) < 0x25 ? 1 : 2;
+    }
+    info->output_width = (w + p->downscale - 1) / p->downscale;
+    info->output_height = (h + p->downscale - 1) / p->downscale;
+    return 0;
+}
+
+static ABI int32_t jpeg_dec_query_memory(const JpegDecCreateParam *p) {
+    if (!p) return JPEG_DEC_INVALID_ADDR;
+    if (p->size != sizeof(*p)) return JPEG_DEC_INVALID_SIZE;
+    if (p->decode_mode < 1 || p->decode_mode > 2) return JPEG_DEC_INVALID_PARAM;
+    if (!p->max_width || p->max_width > 0xFFFF) return JPEG_DEC_INVALID_PARAM;
+    uint32_t aw = ((p->max_width + 0x1f) & ~0x1fu) | 0x10;
+    uint32_t sz = p->decode_mode == 2 ? (aw << 5) * 5 : (aw << 4) * 3;
+    return (int32_t)(sz + aw * 6 + 0x7360);
+}
+
+static ABI int32_t jpeg_dec_create(const JpegDecCreateParam *p, void *memory, uint32_t size,
+                                   JpegDecHandle **handle) {
+    if (!p || !memory) return JPEG_DEC_INVALID_ADDR;
+    int32_t need = jpeg_dec_query_memory(p);
+    if (need < 0) return need;
+    /* Only the handle lives in the work memory (stb decodes into its own); games that size it
+     * themselves give less than the query asks for. */
+    if (size < sizeof(JpegDecHandle) + 0x20) return JPEG_DEC_INVALID_SIZE;
+    if (!handle) return JPEG_DEC_INVALID_ADDR;
+    JpegDecHandle *h = (JpegDecHandle *)align_up((uintptr_t)memory, 0x20);
+    h->self = h; h->size = sizeof(*p); h->decode_mode = p->decode_mode;
+    h->max_width = (p->max_width + 0x1f) & ~0x1fu; h->aux = 0;
+    *handle = h;
+    return 0;
+}
+
+static int jpeg_dec_valid(const JpegDecHandle *h) {
+    return h && aligned((uintptr_t)h, 0x20) && h->self == h;
+}
+
+static ABI int32_t jpeg_dec_delete(JpegDecHandle *h) {
+    if (!jpeg_dec_valid(h)) return JPEG_DEC_INVALID_HANDLE;
+    h->self = NULL;
+    return 0;
+}
+
+static ABI int32_t jpeg_dec_decode(JpegDecHandle *h, const JpegDecDecodeParam *p, JpegDecImageInfo *info) {
+    if (!jpeg_dec_valid(h)) return JPEG_DEC_INVALID_HANDLE;
+    if (!p || !p->jpeg || !p->image) return JPEG_DEC_INVALID_ADDR;
+    if (!p->jpeg_size || !p->image_size) return JPEG_DEC_INVALID_SIZE;
+    if (p->decode_mode > 1 || !ratio_valid(p->downscale)) return JPEG_DEC_INVALID_PARAM;
+    if (p->pixel_format >= 16 || !(0xe03 & (1u << p->pixel_format)) || p->alpha > 0xff)
+        return JPEG_DEC_INVALID_PARAM;
+    int w, h_px, ch;
+    stbi_uc *rgba = stbi_load_from_memory(p->jpeg, (int)p->jpeg_size, &w, &h_px, &ch, 4);
+    if (!rgba) {
+        printf("JpegDec: %u-byte image not decoded (%s)\n", p->jpeg_size, stbi_failure_reason());
+        return JPEG_DEC_DECODE_ERROR;
+    }
+    const uint32_t ratio = p->downscale, ow = ((uint32_t)w + ratio - 1) / ratio,
+                   oh = ((uint32_t)h_px + ratio - 1) / ratio;
+    const int y8 = p->pixel_format == 11, bgra = p->pixel_format == 1;
+    const uint32_t bpp = y8 ? 1 : 4, min_pitch = ow * bpp;
+    const uint32_t pitch = p->image_pitch ? p->image_pitch : min_pitch;
+    int32_t err = 0;
+    if ((uint32_t)w > h->max_width) err = JPEG_DEC_EXCEED_MAX_WIDTH;
+    else if (p->image_pitch && ((bpp == 4 && (pitch & 3)) || pitch < min_pitch)) err = JPEG_DEC_INVALID_PARAM;
+    else if ((uint64_t)pitch * oh > p->image_size)
+        err = p->image_pitch ? JPEG_DEC_INVALID_PARAM : JPEG_DEC_INVALID_SIZE;
+    if (err) { stbi_image_free(rgba); return err; }
+    for (uint32_t y = 0; y < oh; y++) {
+        uint8_t *row = (uint8_t *)p->image + (size_t)y * pitch;
+        for (uint32_t x = 0; x < ow; x++)
+            store_pixel(row + x * bpp, rgba + ((size_t)y * ratio * (uint32_t)w + x * ratio) * 4, bgra, y8, p->alpha);
+    }
+    stbi_image_free(rgba);
+    if (info) {
+        memset(info, 0, sizeof(*info));
+        info->width = (uint32_t)w; info->height = (uint32_t)h_px;
+        info->color_space = ch == 1 ? 2 : 1; info->components = (uint16_t)ch;
+        info->component_id[0] = 1; info->component_id[1] = 2; info->component_id[2] = 3;
+        info->sampling[0] = 0x22; info->sampling[1] = 0x11; info->sampling[2] = 0x11;
+        info->decode_mode = p->decode_mode; info->required_decode_mode = 1;
+        info->output_width = ow; info->output_height = oh;
+    }
+    return (int32_t)(ow << 16 | (oh & 0xFFFF));
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* libScePngDec                                                                               */
+
+typedef struct { const uint8_t *png; uint32_t png_size, reserved; } PngDecParseParam;
+typedef struct { uint32_t width, height; uint16_t color_space, bit_depth; uint32_t flags; } PngDecImageInfo;
+typedef struct { uint32_t size, attribute, max_width; } PngDecCreateParam;
+typedef struct {
+    const uint8_t *png; uint8_t *image; uint32_t png_size, image_size;
+    uint16_t pixel_format, alpha; uint32_t image_pitch;
+} PngDecDecodeParam;
+typedef struct PngDecHandle { struct PngDecHandle *self; uint32_t max_width, attribute; } PngDecHandle;
+_Static_assert(sizeof(PngDecDecodeParam) == 0x20, "ScePngDecDecodeParam layout");
+
+static uint32_t be32(const uint8_t *b) { return (uint32_t)b[0] << 24 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 8 | b[3]; }
+
+static int32_t png_header(const uint8_t *b, uint32_t n, PngDecImageInfo *info) {
+    static const uint8_t sig[8] = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n'};
+    if (n < 33 || memcmp(b, sig, 8) || memcmp(b + 12, "IHDR", 4)) return PNG_DEC_INVALID_DATA;
+    static const uint16_t spaces[7] = {2, 0, 3, 4, 18, 0, 19}; /* by PNG colour type */
+    uint8_t type = b[25];
+    if (type > 6 || !spaces[type]) return PNG_DEC_INVALID_DATA;
+    memset(info, 0, sizeof(*info));
+    info->width = be32(b + 16); info->height = be32(b + 20);
+    info->bit_depth = b[24]; info->color_space = spaces[type];
+    if (b[28]) info->flags |= 1; /* Adam7 */
+    for (uint32_t pos = 8; pos + 8 <= n;) {
+        uint32_t len = be32(b + pos);
+        if (!memcmp(b + pos + 4, "tRNS", 4)) { info->flags |= 2; break; }
+        if (!memcmp(b + pos + 4, "IDAT", 4) || len > n) break;
+        pos += 12 + len;
+    }
+    return 0;
+}
+
+static ABI int32_t png_dec_parse(const PngDecParseParam *p, PngDecImageInfo *info) {
+    if (!p || !info) return PNG_DEC_INVALID_PARAM;
+    if (!p->png) return PNG_DEC_INVALID_ADDR;
+    return png_header(p->png, p->png_size, info);
+}
+
+static ABI int32_t png_dec_query_memory(const PngDecCreateParam *p) {
+    if (!p) return PNG_DEC_INVALID_ADDR;
+    if (p->attribute > 1) return PNG_DEC_INVALID_PARAM;
+    if (p->max_width - 1 > 1000000) return PNG_DEC_INVALID_SIZE;
+    return 0x100;
+}
+
+static ABI int32_t png_dec_create(const PngDecCreateParam *p, void *memory, uint32_t size, PngDecHandle **handle) {
+    int32_t need = png_dec_query_memory(p);
+    if (need < 0) return need;
+    if (!memory || !handle) return PNG_DEC_INVALID_ADDR;
+    if (size < (uint32_t)need) return PNG_DEC_INVALID_SIZE;
+    PngDecHandle *h = (PngDecHandle *)align_up((uintptr_t)memory, 0x10);
+    h->self = h; h->max_width = p->max_width; h->attribute = p->attribute;
+    *handle = h;
+    return 0;
+}
+
+static ABI int32_t png_dec_delete(PngDecHandle *h) {
+    if (!h || h->self != h) return PNG_DEC_INVALID_HANDLE;
+    h->self = NULL;
+    return 0;
+}
+
+static ABI int32_t png_dec_decode(PngDecHandle *h, const PngDecDecodeParam *p, PngDecImageInfo *info) {
+    if (!h || h->self != h) return PNG_DEC_INVALID_HANDLE;
+    if (!p || p->pixel_format > 1) return PNG_DEC_INVALID_PARAM;
+    if (!p->png || !p->image) return PNG_DEC_INVALID_ADDR;
+    PngDecImageInfo header;
+    int32_t r = png_header(p->png, p->png_size, &header);
+    if (r < 0) return r;
+    int w, ht, ch;
+    stbi_uc *rgba = stbi_load_from_memory(p->png, (int)p->png_size, &w, &ht, &ch, 4);
+    if (!rgba) {
+        printf("PngDec: %u-byte image not decoded (%s)\n", p->png_size, stbi_failure_reason());
+        return PNG_DEC_DECODE_ERROR;
+    }
+    const uint32_t pitch = p->image_pitch ? p->image_pitch : (uint32_t)w * 4;
+    if ((uint32_t)w > h->max_width || pitch < (uint32_t)w * 4 || (uint64_t)pitch * (uint32_t)ht > p->image_size) {
+        stbi_image_free(rgba);
+        return PNG_DEC_INVALID_SIZE;
+    }
+    /* Colour types without alpha take alpha_value; with alpha, the image's own. */
+    const int has_alpha = header.color_space == 18 || header.color_space == 19 || (header.flags & 2);
+    for (int y = 0; y < ht; y++)
+        for (int x = 0; x < w; x++) {
+            uint8_t *dst = p->image + (size_t)y * pitch + (size_t)x * 4;
+            store_pixel(dst, rgba + ((size_t)y * (size_t)w + (size_t)x) * 4, p->pixel_format == 1, 0, 0);
+            if (!has_alpha) dst[3] = (uint8_t)p->alpha;
+        }
+    stbi_image_free(rgba);
+    if (info) *info = header;
+    return w > 32767 || ht > 32767 ? 0 : (int32_t)((uint32_t)w << 16 | (uint32_t)ht);
+}
+
+static const RuntimeExport exports[] = {
+    {"sceJpegEncQueryMemorySize", jpeg_enc_query_memory}, {"sceJpegEncCreate", jpeg_enc_create},
+    {"sceJpegEncDelete", jpeg_enc_delete}, {"sceJpegEncEncode", jpeg_enc_encode},
+    {"sceJpegDecQueryMemorySize", jpeg_dec_query_memory}, {"sceJpegDecCreate", jpeg_dec_create},
+    {"sceJpegDecDelete", jpeg_dec_delete}, {"sceJpegDecDecode", jpeg_dec_decode},
+    {"sceJpegDecDecodeWithInputControl", jpeg_dec_decode}, {"sceJpegDecParseHeader", jpeg_dec_parse},
+    {"scePngDecQueryMemorySize", png_dec_query_memory}, {"scePngDecCreate", png_dec_create},
+    {"scePngDecDelete", png_dec_delete}, {"scePngDecDecode", png_dec_decode},
+    {"scePngDecParseHeader", png_dec_parse},
+};
