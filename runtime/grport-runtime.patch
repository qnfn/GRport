+/// DCport: a DriveClub icon texture (one of BbPromptIcons::DcTextures), with its Xbox 360
+/// button drawn and encoded now (once per address; the game reuses few).
+bool AddDriveclub(uintptr_t address, size_t size, uint32_t width, uint32_t height) {
+    for (int i = 0; i < BbPromptIcons::DcCount; ++i) {
+        const auto icon = BbPromptIcons::DcIcon(i);
+        const auto& t = BbPromptIcons::DcTextures[i];
+        if (uint32_t(t.width) != width || uint32_t(t.height) != height || BbPromptIcons::DcBytes(icon) != size) {
+            continue;
+        }
+        Bytes bytes = Gather(address, -1, i);
+        if (Hash(bytes) != t.hash) continue;
+        {
+            std::scoped_lock lock{mutex};
+            for (const Entry& e : entries) {
+                if (e.base == address && e.dc == i) return true;
+            }
+        }
+        static const bool font = BbPromptIcons::SetFont(bb_font_ttf);
+        std::array<Bytes, BbPromptIcons::DcStyleCount> looks;
+        for (int style = 0; font && style < BbPromptIcons::DcStyleCount; ++style) {
+            looks[style] = BbPromptIcons::EncodeDc(icon, BbPromptIcons::DrawDc(icon, BbPromptIcons::DcStyle(style)), bytes);
+        }
+        Add(address, -1, -1, std::move(bytes), i, std::move(looks));
+        return true;
+    }
+    return false;
+}
