+++ b/gpu/shadps4/video_core/texture_cache/photo_readback.h
@@ -0,0 +1,80 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: Gravity Rush 2's photo mode, adapted from GR2fork (github.com/junminlee2004/GR2fork,
+// commit 124096c4 "Add Gravity Rush 2 photo mode and album").
+
+#pragma once
+
+#include <atomic>
+#include "common/logging/log.h"
+#include "common/types.h"
+#include "video_core/texture_cache/image.h"
+#include "video_core/texture_cache/types.h"
+
+namespace VideoCore {
+
+/// The game draws a photo into a linear colour target of one size (1024x1024 in Gravity
+/// Rush 2), copies that target's guest memory, which the GPU never wrote back, and hands the
+/// copy to sceJpegEncEncode. This keeps track of the last image of the armed size bound as a
+/// colour target or storage image, and copies its pixels out when the photo is encoded.
+class PhotoReadback {
+public:
+    /// Starts tracking images of exactly this size. Also turns on ClampLayers.
+    static void Arm(u32 width, u32 height) noexcept {
+        armed_extent.store(PackExtent(width, height), std::memory_order_relaxed);
+    }
+    static bool IsArmed(u32 width, u32 height) noexcept {
+        return width != 0 && armed_extent.load(std::memory_order_relaxed) == PackExtent(width, height);
+    }
+
+    /// GPU command thread: an image was bound as a colour target or written as a storage image.
+    static void Track(const Image& image, ImageId image_id) noexcept {
+        const u64 extent = armed_extent.load(std::memory_order_relaxed);
+        if (extent == 0) [[likely]] {
+            return;
+        }
+        if (PackExtent(image.info.size.width, image.info.size.height) == extent &&
+            !image.info.props.is_tiled && image.info.guest_address != 0) {
+            tracked_index.store(image_id.index, std::memory_order_relaxed);
+        }
+    }
+
+    /// The image is being erased.
+    static void Forget(ImageId image_id) noexcept {
+        u32 index = image_id.index;
+        if (tracked_index.load(std::memory_order_relaxed) == index) [[unlikely]] {
+            tracked_index.compare_exchange_strong(index, ImageId::INVALID_INDEX);
+        }
+    }
+
+    /// The album binds a T# of several thousand layers (4609 was seen), which cannot be
+    /// allocated. While armed, a T# with more than 2048 layers is built with one.
+    static u32 ClampLayers(u32 layers) noexcept {
+        if (layers <= 2048 || armed_extent.load(std::memory_order_relaxed) == 0) [[likely]] {
+            return layers;
+        }
+        return 1;
+    }
+    static void ClampView(u32 layers, SubresourceRange& range) noexcept {
+        if (layers <= 2048 || armed_extent.load(std::memory_order_relaxed) == 0) [[likely]] {
+            return;
+        }
+        range.base.layer = 0;
+        range.extent.layers = 1;
+    }
+
+    /// Guest thread: copies the tracked image into `out` (rows of `pitch` bytes, `height` rows)
+    /// when its rows are that long. Blocks until the GPU command thread has run the copy.
+    static bool Download(void* out, u32 pitch, u32 height);
+
+private:
+    static constexpr u64 PackExtent(u32 width, u32 height) noexcept {
+        return u64{width} << 32 | height;
+    }
+    static bool DownloadOnGpuThread(void* out, u32 pitch, u32 height);
+
+    static inline std::atomic<u64> armed_extent{};
+    static inline std::atomic<u32> tracked_index{ImageId::INVALID_INDEX};
+};
