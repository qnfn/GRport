@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// GRport: motion vectors for the temporal upscaler from Gravity Rush 2's own velocity target
+// (its G-buffer's fourth target, R16G16F: the previous minus the current clip position over w,
+// per object, without the upscaler's jitter). Pixels, previous - current, like camera_motion.
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(binding = 0) uniform texture2D velocity_tex;
+layout(binding = 1, rg16f) uniform writeonly image2D motion_img;
+
+layout(push_constant) uniform Constants {
+    vec2 size;  // pixels
+    vec2 scale; // velocity -> pixels: (width / 2, -height / 2) for clip space with y up
+};
+
+void main() {
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, ivec2(size)))) {
+        return;
+    }
+    const vec2 velocity = texelFetch(velocity_tex, p, 0).xy;
+    imageStore(motion_img, p, vec4(velocity * scale, 0.0, 0.0));
+}
