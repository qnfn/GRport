+#endif
+
+/* Stubs keep the guest signatures as documentation of the contract. */
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+
+#define DC_ERROR_GENERIC ((int32_t)0x80020001)  /* SCE_KERNEL_ERROR_EPERM */
+#define DC_ERROR_NOENT ((int32_t)0x80020002)
+#define DC_ERROR_BUSY ((int32_t)0x80020010)
+#define POSIX_EINVAL 22
+#define POSIX_EBUSY 16
+#define POSIX_EAGAIN 35
+#define POSIX_EPERM 1
+
+static int dc_trace = -1;
+static void trace(const char *what) {
+    if (dc_trace < 0) dc_trace = getenv("BB_DC_TRACE") && *getenv("BB_DC_TRACE") == '1';
+    if (dc_trace) printf("DC: %s\n", what);
+}
+
+/* --- Generic results -------------------------------------------------------------------- */
+static ABI int32_t ok(void) { return 0; }
+static ABI int32_t fail_generic(void) { return DC_ERROR_GENERIC; }
+static ABI int32_t one(void) { return 1; }
+/* Common dialogs: SCE_COMMON_DIALOG_STATUS_FINISHED, as if the player closed them. */
+static ABI int32_t dialog_finished(void) { return 3; }
+static ABI int32_t dialog_none(void) { return 0; }  /* SCE_COMMON_DIALOG_STATUS_NONE */
+static ABI int32_t dialog_result(int32_t *result) {
+    if (result) result[1] = 1;  /* { mode, result = canceled } */
+    return 0;
+}
+/* libSceErrorDialog: the system's error message, closed at once (nothing is drawn). Its status
+ * goes NONE -> INITIALIZED (Initialize) -> RUNNING (Open) -> FINISHED (next update) -> NONE
+ * (Terminate), as on the PS4: games wait for NONE after Terminate. Gravity Rush 2 opens it for
+ * "not signed in" when a ranking is asked for; with FINISHED returned for ever, it called
+ * Terminate each frame and its "Transmitting" window never closed (#4). */
+enum { DIALOG_NONE, DIALOG_INITIALIZED, DIALOG_RUNNING, DIALOG_FINISHED };
+#define DIALOG_NOT_INITIALIZED ((int32_t)0x80B80003)
+#define DIALOG_ALREADY_INITIALIZED ((int32_t)0x80B80004)
+#define DIALOG_INVALID_STATE ((int32_t)0x80B80006)
+#define DIALOG_NOT_RUNNING ((int32_t)0x80B8000B)
+#define DIALOG_ARG_NULL ((int32_t)0x80B8000D)
+static int32_t error_dialog_status = DIALOG_NONE;
+static ABI int32_t error_dialog_init(void) {
+    if (error_dialog_status != DIALOG_NONE) return DIALOG_ALREADY_INITIALIZED;
+    error_dialog_status = DIALOG_INITIALIZED;
+    return 0;
+}
+static ABI int32_t error_dialog_open(const int32_t *param) { /* { size, errorCode, userId, reserved } */
+    if (error_dialog_status != DIALOG_INITIALIZED && error_dialog_status != DIALOG_FINISHED) return DIALOG_INVALID_STATE;
+    if (!param) return DIALOG_ARG_NULL;
+    printf("Error dialog: code %#x (closed at once)\n", (unsigned)param[1]);
+    error_dialog_status = DIALOG_RUNNING;
+    return 0;
+}
+static ABI int32_t error_dialog_update(void) {
+    if (error_dialog_status == DIALOG_RUNNING) error_dialog_status = DIALOG_FINISHED;
+    return error_dialog_status;
+}
+static ABI int32_t error_dialog_get_status(void) { return error_dialog_status; }
+static ABI int32_t error_dialog_close(void) {
+    if (error_dialog_status != DIALOG_RUNNING) return DIALOG_NOT_RUNNING;
+    error_dialog_status = DIALOG_FINISHED;
+    return 0;
+}
+static ABI int32_t error_dialog_term(void) {
+    if (error_dialog_status == DIALOG_RUNNING) error_dialog_status = DIALOG_FINISHED;
+    if (error_dialog_status == DIALOG_NONE) return DIALOG_NOT_INITIALIZED;
+    error_dialog_status = DIALOG_NONE;
+    return 0;
+}
