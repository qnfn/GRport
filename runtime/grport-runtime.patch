diff --git a/src/runtime_eventflag.c b/src/runtime_eventflag.c
new file mode 100644
index 0000000..5446299
--- /dev/null
+++ b/src/runtime_eventflag.c
@@ -0,0 +1,240 @@
+/* Kernel event flags: a 64-bit pattern threads set and clear, and wait on until all (AND) or
+ * any (OR) of their bits are set; a waiter may clear all bits or its own bits on waking.
+ * Gravity Rush 2 synchronises its loading threads with them. Waiters are served FIFO, like the
+ * runtime's semaphores (there is no PS4 priority scheduler). */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <errno.h>
+#include <time.h>
+#define ERR(n) ((int32_t)(UINT32_C(0x80020000)|(n)))
+#define ESRCH 3
+#define EACCES 13
+#define EBUSY 16
+#define EINVAL 22
+#define EPERM 1
+#define ETIMEDOUT_PS4 60
+#define ENAMETOOLONG_PS4 63
+#define ECANCELED_PS4 85
+enum { WAIT_AND=0x01, WAIT_OR=0x02, CLEAR_ALL=0x10, CLEAR_BITS=0x20 };
+enum { ATTR_SINGLE=0x10, ATTR_MULTI=0x20 };
+typedef struct Waiter {
+    uint64_t bits;
+    uint32_t mode;
+    uint64_t seen;         /* the pattern when the wait was satisfied or ended */
+    int32_t result;
+    int done;
+    pthread_cond_t event;
+    struct Waiter *next;
+} Waiter;
+typedef struct EventFlag {
+    uint32_t magic;
+    uint32_t attr;
+    uint64_t bits;
+    unsigned active;       /* threads inside a wait */
+    int deleted;
+    Waiter *first;
+    char name[32];
+} EventFlag;
+#define MAGIC 0x45564631u  /* "EVF1": catches stale or foreign handles */
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+static size_t created, waits, satisfied, timed_out;
+#ifdef _WIN32
+#define WAIT_CLOCK CLOCK_REALTIME
+#else
+#define WAIT_CLOCK CLOCK_MONOTONIC
+#endif
+static uint64_t now_ns(void) {
+    struct timespec t;
+    if (clock_gettime(WAIT_CLOCK,&t)) { perror("clock_gettime"); exit(1); }
+    return (uint64_t)t.tv_sec*1000000000+(uint64_t)t.tv_nsec;
+}
+static void host_check(int e) {
+    if (e) { fprintf(stderr,"STOP: event flag host error %d\n",e); exit(21); }
+}
+static int valid_mode(uint32_t mode) {
+    uint32_t wait=mode&0xf, clear=mode&0xf0;
+    return (wait==WAIT_AND || wait==WAIT_OR) && (clear==0 || clear==CLEAR_ALL || clear==CLEAR_BITS) &&
+           !(mode & ~0xffu);
+}
+static int met(const EventFlag *f, uint64_t bits, uint32_t mode) {
+    return (mode&0xf)==WAIT_AND ? (f->bits&bits)==bits : (f->bits&bits)!=0;
+}
+static void consume(EventFlag *f, uint64_t bits, uint32_t mode) {
+    if ((mode&0xf0)==CLEAR_ALL) f->bits=0;
+    else if ((mode&0xf0)==CLEAR_BITS) f->bits&=~bits;
+}
+static EventFlag *handle(void *ef) {
+    EventFlag *f=ef;
+    return f && f->magic==MAGIC && !f->deleted ? f : NULL;
+}
+/* Wakes, in order, every waiter whose condition the pattern now meets; a clearing waiter can
+ * stop later ones from waking, as on the PS4. Caller holds the lock. */
+static void wake_matching(EventFlag *f) {
+    Waiter **p=&f->first;
+    while (*p) {
+        Waiter *w=*p;
+        if (!met(f,w->bits,w->mode)) { p=&w->next; continue; }
+        w->seen=f->bits;
+        consume(f,w->bits,w->mode);
+        *p=w->next; w->result=0; w->done=1; ++satisfied;
+        host_check(pthread_cond_signal(&w->event));
+    }
+}
+static void wake_all(EventFlag *f, int32_t result) {
+    while (f->first) {
+        Waiter *w=f->first; f->first=w->next;
+        w->seen=f->bits; w->result=result; w->done=1;
+        host_check(pthread_cond_signal(&w->event));
+    }
+}
+static ABI int32_t evf_create(void **out, const char *name, uint32_t attr, uint64_t pattern,
+                              const void *options) {
+    if (!out || !name || options || (attr & ~0x33u) || (attr&0xf)==0x3 || (attr&0xf0)==0x30)
+        return ERR(EINVAL);
+    if (strlen(name)>=sizeof(((EventFlag *)0)->name)) return ERR(ENAMETOOLONG_PS4);
+    EventFlag *f=calloc(1,sizeof(*f));
+    if (!f) return ERR(12);
+    f->magic=MAGIC; f->attr=attr; f->bits=pattern;
+    strcpy(f->name,name);
+    pthread_mutex_lock(&lock);
+    ++created;
+    pthread_mutex_unlock(&lock);
+    *out=f;
+    printf("Runtime: event flag '%s' created (attr=0x%x, pattern=0x%llx)\n",name,attr,
+           (unsigned long long)pattern);
+    return 0;
+}
+static ABI int32_t evf_delete(void *ef) {
+    pthread_mutex_lock(&lock);
+    EventFlag *f=handle(ef);
+    if (!f) { pthread_mutex_unlock(&lock); return ERR(ESRCH); }
+    f->deleted=1;
+    wake_all(f,ERR(EACCES));
+    int free_now=!f->active;
+    pthread_mutex_unlock(&lock);
+    if (free_now) { f->magic=0; free(f); }
+    return 0;
+}
+static ABI int32_t evf_set(void *ef, uint64_t bits) {
+    pthread_mutex_lock(&lock);
+    EventFlag *f=handle(ef);
+    if (!f) { pthread_mutex_unlock(&lock); return ERR(ESRCH); }
+    f->bits|=bits;
+    wake_matching(f);
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+static ABI int32_t evf_clear(void *ef, uint64_t bits) {
+    pthread_mutex_lock(&lock);
+    EventFlag *f=handle(ef);
+    if (!f) { pthread_mutex_unlock(&lock); return ERR(ESRCH); }
+    f->bits&=bits;  /* the argument is the mask of bits to keep */
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+static int32_t wait_flag(void *ef, uint64_t bits, uint32_t mode, uint64_t *result,
+                         uint32_t *timeout, int block) {
+    if (!bits || !valid_mode(mode)) return ERR(EINVAL);
+    pthread_mutex_lock(&lock);
+    EventFlag *f=handle(ef);
+    int32_t status=0;
+    if (!f) status=ERR(ESRCH);
+    else if (block && (f->attr&0xf0)!=ATTR_MULTI && f->first) status=ERR(EPERM); /* single waiter */
+    else if (met(f,bits,mode)) {
+        if (result) *result=f->bits;
+        consume(f,bits,mode);
+        ++satisfied;
+    } else if (!block) {
+        if (result) *result=f->bits;
+        status=ERR(EBUSY);
+    } else if (timeout && !*timeout) {
+        if (result) *result=f->bits;
+        status=ERR(ETIMEDOUT_PS4); ++timed_out;
+    } else {
+        Waiter w={.bits=bits,.mode=mode};
+        pthread_condattr_t attr;
+        host_check(pthread_condattr_init(&attr));
+        host_check(pthread_condattr_setclock(&attr,WAIT_CLOCK));
+        host_check(pthread_cond_init(&w.event,&attr));
+        host_check(pthread_condattr_destroy(&attr));
+        Waiter **tail=&f->first;
+        while (*tail) tail=&(*tail)->next;
+        *tail=&w; ++f->active; ++waits;
+        uint64_t deadline=timeout ? now_ns()+(uint64_t)*timeout*1000 : 0;
+        struct timespec end={.tv_sec=(time_t)(deadline/1000000000),.tv_nsec=(long)(deadline%1000000000)};
+        int reported=0;
+        while (!w.done) {
+            int e;
+            if (timeout) e=pthread_cond_timedwait(&w.event,&lock,&end);
+            else if (reported) e=pthread_cond_wait(&w.event,&lock);
+            else {
+                /* A wait without a timeout that lasts says which handshake is stuck. */
+                uint64_t later=now_ns()+UINT64_C(3000000000);
+                struct timespec at={.tv_sec=(time_t)(later/1000000000),.tv_nsec=(long)(later%1000000000)};
+                e=pthread_cond_timedwait(&w.event,&lock,&at);
+                if (e==ETIMEDOUT && !w.done) {
+                    reported=1;
+                    fprintf(stderr,"Runtime: waiting over 3 s on event flag '%s' for 0x%llx (%s), "
+                            "pattern 0x%llx\n",f->name,(unsigned long long)bits,
+                            (mode&0xf)==WAIT_AND ? "all" : "any",(unsigned long long)f->bits);
+                    continue;
+                }
+            }
+            if (e==ETIMEDOUT && !w.done) {
+                Waiter **p=&f->first;
+                while (*p!=&w) p=&(*p)->next;
+                *p=w.next; w.seen=f->bits; w.result=ERR(ETIMEDOUT_PS4); w.done=1; ++timed_out;
+            } else if (e!=ETIMEDOUT) host_check(e);
+        }
+        status=w.result;
+        if (result) *result=w.seen;
+        if (timeout) {
+            uint64_t now=now_ns();
+            *timeout=status ? 0 : (uint32_t)(now>=deadline ? 0 : (deadline-now)/1000);
+        }
+        host_check(pthread_cond_destroy(&w.event));
+        if (!--f->active && f->deleted) {
+            pthread_mutex_unlock(&lock);
+            f->magic=0; free(f);
+            return status;
+        }
+    }
+    pthread_mutex_unlock(&lock);
+    return status;
+}
+static ABI int32_t evf_wait(void *ef, uint64_t bits, uint32_t mode, uint64_t *result,
+                            uint32_t *timeout) {
+    return wait_flag(ef,bits,mode,result,timeout,1);
+}
+static ABI int32_t evf_poll(void *ef, uint64_t bits, uint32_t mode, uint64_t *result) {
+    return wait_flag(ef,bits,mode,result,NULL,0);
+}
+static ABI int32_t evf_cancel(void *ef, uint64_t pattern, int32_t *waiters) {
+    pthread_mutex_lock(&lock);
+    EventFlag *f=handle(ef);
+    if (!f) { pthread_mutex_unlock(&lock); return ERR(ESRCH); }
+    int32_t n=0;
+    for (Waiter *w=f->first;w;w=w->next) ++n;
+    f->bits=pattern;
+    wake_all(f,ERR(ECANCELED_PS4));
+    pthread_mutex_unlock(&lock);
+    if (waiters) *waiters=n;
+    return 0;
+}
+static const RuntimeExport exports[]={
+    {"sceKernelCreateEventFlag",evf_create}, {"sceKernelDeleteEventFlag",evf_delete},
+    {"sceKernelSetEventFlag",evf_set}, {"sceKernelClearEventFlag",evf_clear},
+    {"sceKernelWaitEventFlag",evf_wait}, {"sceKernelPollEventFlag",evf_poll},
+    {"sceKernelCancelEventFlag",evf_cancel},
+};
+uintptr_t runtime_eventflag_resolve(const char *name) { return RUNTIME_LOOKUP(exports,name); }
+void runtime_eventflag_report(void) {
+    pthread_mutex_lock(&lock);
+    printf("Runtime: event flags created=%zu, blocking waits=%zu, satisfied=%zu, timeouts=%zu\n",
+           created,waits,satisfied,timed_out);
+    pthread_mutex_unlock(&lock);
+}
diff --git a/src/runtime_fiber.c b/src/runtime_fiber.c
new file mode 100644
index 0000000..2763f87
--- /dev/null
+++ b/src/runtime_fiber.c
@@ -0,0 +1,324 @@
+/* PS4 fibers (libSceFiber): user-scheduled coroutines a thread starts with Run and that hand
+ * control to each other with Switch until one returns to the thread. Gravity Rush 2 runs its
+ * background jobs on them (the BGFiberWorker threads).
+ *
+ * The game owns the 256-byte fiber object and the memory a fiber runs on (its "context");
+ * a fiber without one runs on the thread's own stack, below the suspended Run call, and starts
+ * over from its entry each time it is run. A suspended fiber keeps its registers in its object,
+ * so any thread can resume it. Only the registers the SysV ABI preserves across a call are
+ * switched, with the SSE and x87 control words. */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#define ERR_NULL       ((int32_t)UINT32_C(0x80590001))
+#define ERR_ALIGNMENT  ((int32_t)UINT32_C(0x80590002))
+#define ERR_RANGE      ((int32_t)UINT32_C(0x80590003))
+#define ERR_INVALID    ((int32_t)UINT32_C(0x80590004))
+#define ERR_PERMISSION ((int32_t)UINT32_C(0x80590005))
+#define ERR_STATE      ((int32_t)UINT32_C(0x80590006))
+#define MAGIC_HEAD UINT32_C(0x31424647)  /* "GFB1" */
+#define MAGIC_TAIL UINT32_C(0x67627031)
+#define OPT_MAGIC  UINT32_C(0xbb40e64d)
+#define MIN_CONTEXT 512
+#define SDK_FPU_DEFAULTS 0x03500000u     /* SDK 3.50+: fibers start with default FPU state */
+enum { STATE_RUN=1, STATE_IDLE=2, STATE_TERMINATED=3 };
+
+typedef struct Regs {          /* offsets are used by the switch below */
+    uint64_t rbx, rbp, r12, r13, r14, r15, rsp;   /* 0..48 */
+    uint32_t mxcsr; uint16_t fpucw; uint16_t pad;  /* 56, 60 */
+    uint64_t stack_base, stack_limit;             /* 64, 72: the thread's TEB view */
+} Regs;
+typedef struct Fiber {         /* lives in the game's 256-byte fiber object */
+    uint32_t magic_head;
+    uint32_t state;            /* changed under the fiber lock */
+    uint64_t entry, arg_init;
+    unsigned char *context; uint64_t context_size;
+    unsigned char *stack;      /* the host stack the fiber runs on (see host_stack) */
+    char name[32];
+    Regs regs;
+    uint32_t suspended;        /* regs hold a resumable fiber */
+    uint32_t fpu_defaults;
+    uint32_t magic_tail;
+} Fiber;
+_Static_assert(sizeof(Fiber)<=256, "the game allocates 256 bytes per fiber");
+
+typedef struct FiberThread {
+    Fiber *current;            /* the fiber running on this thread, or NULL */
+    Fiber *previous;           /* switched away from; becomes idle once its registers are saved */
+    Regs thread;               /* the thread, suspended in Run */
+    uint64_t pass;             /* argument handed to the fiber that resumes */
+    uint64_t returned;         /* argument a fiber hands back to Run */
+} FiberThread;
+static _Thread_local FiberThread fiber_thread;
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+static size_t initialized, runs, switches, returns;
+
+/* Fibers run on stacks of the runtime's own rather than on the game's context memory:
+   runtime functions called from a fiber (opening a movie with FFmpeg, logging) need far more
+   than the 96 KiB Gravity Rush 2 gives its job fibers, and overflowing it corrupted memory.
+   One stack per game context, kept for when the fiber is initialized again. */
+#define FIBER_STACK (UINT64_C(1) << 20)
+static struct { void *context; unsigned char *stack; } stacks[1024];
+static size_t stack_count;
+static unsigned char *host_stack(void *context) {
+    for (size_t i=0;i<stack_count;++i) if (stacks[i].context==context) return stacks[i].stack;
+    if (stack_count==sizeof(stacks)/sizeof(*stacks)) return NULL;
+    unsigned char *stack=runtime_low_map(FIBER_STACK,PROT_READ|PROT_WRITE);
+    if (!stack) return NULL;
+    stacks[stack_count].context=context; stacks[stack_count].stack=stack; ++stack_count;
+    return stack;
+}
+
+/* Thread-local state is looked up again after every switch: a resumed fiber may now be on
+ * another thread, and the compiler must not reuse the old thread's address. */
+static __attribute__((noinline)) FiberThread *self_thread(void) {
+    FiberThread *t=&fiber_thread;
+    __asm__ volatile("" : "+r"(t));
+    return t;
+}
+
+/* fiber_switch(save, load): saves the caller into save, continues where load was saved (or at
+ * a fresh fiber's start). fiber_start: first code of a fresh fiber: r12=entry, r13=argument on
+ * initialize, r14=argument on run. */
+ABI void fiber_switch(Regs *save, const Regs *load);
+ABI void fiber_start(void);
+__asm__(
+    ".text\n"
+    ".globl fiber_switch\n"
+    "fiber_switch:\n"
+    "    movq %rbx, 0(%rdi)\n"
+    "    movq %rbp, 8(%rdi)\n"
+    "    movq %r12, 16(%rdi)\n"
+    "    movq %r13, 24(%rdi)\n"
+    "    movq %r14, 32(%rdi)\n"
+    "    movq %r15, 40(%rdi)\n"
+    "    movq %rsp, 48(%rdi)\n"
+    "    stmxcsr 56(%rdi)\n"
+    "    fnstcw 60(%rdi)\n"
+    "    movq 0(%rsi), %rbx\n"
+    "    movq 8(%rsi), %rbp\n"
+    "    movq 16(%rsi), %r12\n"
+    "    movq 24(%rsi), %r13\n"
+    "    movq 32(%rsi), %r14\n"
+    "    movq 40(%rsi), %r15\n"
+    "    ldmxcsr 56(%rsi)\n"
+    "    fldcw 60(%rsi)\n"
+    "    movq 48(%rsi), %rsp\n"
+    "    ret\n"
+    ".globl fiber_start\n"
+    "fiber_start:\n"
+    "    call fiber_begin\n"
+    "    movq %r13, %rdi\n"
+    "    movq %r14, %rsi\n"
+    "    call *%r12\n"
+    "    call fiber_entry_returned\n"
+    "    ud2\n"
+);
+
+static void stack_view(uint64_t *base, uint64_t *limit) {
+#ifdef _WIN32
+    NT_TIB *tib=(NT_TIB *)NtCurrentTeb();
+    *base=(uint64_t)(uintptr_t)tib->StackBase; *limit=(uint64_t)(uintptr_t)tib->StackLimit;
+#else
+    *base=*limit=0;
+#endif
+}
+static void set_stack_view(uint64_t base, uint64_t limit) {
+#ifdef _WIN32
+    if (!base) return;
+    NT_TIB *tib=(NT_TIB *)NtCurrentTeb();
+    tib->StackBase=(void *)(uintptr_t)base; tib->StackLimit=(void *)(uintptr_t)limit;
+#else
+    (void)base; (void)limit;
+#endif
+}
+/* Saves the caller in save and continues in load, with Windows' stack range following. */
+static void switch_to(Regs *save, Regs *load) {
+    stack_view(&save->stack_base,&save->stack_limit);
+    set_stack_view(load->stack_base,load->stack_limit);
+    fiber_switch(save,load);
+}
+
+/* Registers that start `f` on [low, top) with `arg` as its argument on run. */
+static void fresh_regs(Regs *r, const Fiber *f, unsigned char *low, unsigned char *top,
+                       uint64_t arg) {
+    uintptr_t sp=((uintptr_t)top & ~(uintptr_t)15)-8;  /* fiber_start runs as if called */
+    *(uint64_t *)sp=(uint64_t)(uintptr_t)fiber_start;
+    memset(r,0,sizeof(*r));
+    r->rsp=sp; r->r12=f->entry; r->r13=f->arg_init; r->r14=arg;
+    if (f->fpu_defaults) { r->mxcsr=0x9fc0; r->fpucw=0x037f; }
+    else { __asm__ volatile("stmxcsr %0" : "=m"(r->mxcsr)); __asm__ volatile("fnstcw %0" : "=m"(r->fpucw)); }
+    r->stack_base=(uint64_t)(uintptr_t)top; r->stack_limit=(uint64_t)(uintptr_t)low;
+}
+/* Continues `target` (resumed, or started fresh), saving the caller in save. A fiber without
+ * a context starts on the thread's stack below where the thread waits in Run. */
+static void enter(FiberThread *t, Regs *save, Fiber *target, uint64_t arg) {
+    t->pass=arg;
+    if (target->suspended) {
+        target->suspended=0;
+        switch_to(save,&target->regs);
+        return;
+    }
+    Regs fresh;
+    if (target->context) {
+        if (target->stack) fresh_regs(&fresh,target,target->stack,target->stack+FIBER_STACK,arg);
+        else fresh_regs(&fresh,target,target->context,target->context+target->context_size,arg);
+    } else {
+        unsigned char *top=(unsigned char *)(uintptr_t)t->thread.rsp-8192;
+        fresh_regs(&fresh,target,top-(1u<<20),top,arg);
+        stack_view(&fresh.stack_base,&fresh.stack_limit);  /* still the thread's stack */
+    }
+    switch_to(save,&fresh);
+}
+/* Runs first on a fiber that was switched to: the one it left becomes idle now that its
+ * registers are saved. */
+ABI void fiber_begin(void) {
+    FiberThread *t=self_thread();
+    if (t->previous) {
+        pthread_mutex_lock(&lock);
+        t->previous->state=STATE_IDLE;
+        pthread_mutex_unlock(&lock);
+        t->previous=NULL;
+    }
+}
+ABI void fiber_entry_returned(void) {
+    FiberThread *t=self_thread();
+    fprintf(stderr,"STOP: fiber '%s' returned from its entry function (fibers must return to "
+            "their thread with sceFiberReturnToThread)\n",t->current ? t->current->name : "?");
+    exit(21);
+}
+static int valid(const Fiber *f) {
+    return f->magic_head==MAGIC_HEAD && f->magic_tail==MAGIC_TAIL;
+}
+static int claim(Fiber *f) {   /* idle -> run */
+    pthread_mutex_lock(&lock);
+    int ok=f->state==STATE_IDLE;
+    if (ok) f->state=STATE_RUN;
+    pthread_mutex_unlock(&lock);
+    return ok;
+}
+
+static ABI int32_t fiber_initialize(Fiber *f, const char *name, uint64_t entry, uint64_t arg,
+                                    void *context, uint64_t size, const uint32_t *options,
+                                    uint32_t build_version) {
+    if (!f || !name || !entry) return ERR_NULL;
+    if (((uintptr_t)f & 7) || ((uintptr_t)context & 15) || ((uintptr_t)options & 7)) return ERR_ALIGNMENT;
+    if (size && size<MIN_CONTEXT) return ERR_RANGE;
+    if ((size & 15) || (!context)!=(!size) || (options && *options!=OPT_MAGIC)) return ERR_INVALID;
+    memset(f,0,sizeof(*f));
+    snprintf(f->name,sizeof(f->name),"%s",name);
+    f->entry=entry; f->arg_init=arg;
+    f->context=context; f->context_size=size;
+    f->fpu_defaults=build_version>=SDK_FPU_DEFAULTS;
+    f->magic_head=MAGIC_HEAD; f->magic_tail=MAGIC_TAIL;
+    f->state=STATE_IDLE;
+    pthread_mutex_lock(&lock);
+    if (context) f->stack=host_stack(context);  /* NULL: the game's own memory, as before */
+    if (initialized++<16)
+        printf("Runtime: fiber '%s' initialized (context %llu bytes)\n",f->name,(unsigned long long)size);
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+static ABI int32_t fiber_opt_initialize(uint32_t *options) {
+    if (!options) return ERR_NULL;
+    if ((uintptr_t)options & 7) return ERR_ALIGNMENT;
+    *options=OPT_MAGIC; return 0;
+}
+static ABI int32_t fiber_finalize(Fiber *f) {
+    if (!f) return ERR_NULL;
+    if ((uintptr_t)f & 7) return ERR_ALIGNMENT;
+    if (!valid(f)) return ERR_INVALID;
+    pthread_mutex_lock(&lock);
+    int ok=f->state==STATE_IDLE;
+    if (ok) { f->state=STATE_TERMINATED; f->magic_head=f->magic_tail=0; }
+    pthread_mutex_unlock(&lock);
+    return ok ? 0 : ERR_STATE;
+}
+static ABI int32_t fiber_run(Fiber *f, uint64_t arg, uint64_t *returned) {
+    if (!f) return ERR_NULL;
+    if ((uintptr_t)f & 7) return ERR_ALIGNMENT;
+    if (!valid(f)) return ERR_INVALID;
+    FiberThread *t=self_thread();
+    if (t->current) return ERR_PERMISSION;   /* fibers switch, they do not run fibers */
+    if (!claim(f)) return ERR_STATE;
+    t->current=f; t->previous=NULL; t->returned=0;
+    pthread_mutex_lock(&lock); ++runs; pthread_mutex_unlock(&lock);
+    enter(t,&t->thread,f,arg);
+    /* Back on this thread: a fiber called sceFiberReturnToThread. */
+    t=self_thread();
+    Fiber *last=t->current;
+    t->current=NULL;
+    pthread_mutex_lock(&lock);
+    if (last) last->state=STATE_IDLE;
+    pthread_mutex_unlock(&lock);
+    if (returned) *returned=t->returned;
+    return 0;
+}
+static ABI int32_t fiber_switch_to(Fiber *f, uint64_t arg, uint64_t *on_run) {
+    if (!f) return ERR_NULL;
+    if ((uintptr_t)f & 7) return ERR_ALIGNMENT;
+    if (!valid(f)) return ERR_INVALID;
+    FiberThread *t=self_thread();
+    Fiber *cur=t->current;
+    if (!cur) return ERR_PERMISSION;
+    if (!claim(f)) return ERR_STATE;
+    t->current=f; t->previous=cur;
+    pthread_mutex_lock(&lock); ++switches; pthread_mutex_unlock(&lock);
+    if (cur->context) {
+        cur->suspended=1;
+        enter(t,&cur->regs,f,arg);
+    } else {
+        Regs discard;              /* a contextless fiber is not resumed: it starts over */
+        enter(t,&discard,f,arg);
+    }
+    /* Resumed by Run or Switch, maybe on another thread. */
+    fiber_begin();
+    t=self_thread();
+    if (on_run) *on_run=t->pass;
+    return 0;
+}
+static ABI int32_t fiber_return_to_thread(uint64_t arg, uint64_t *on_run) {
+    FiberThread *t=self_thread();
+    Fiber *cur=t->current;
+    if (!cur) return ERR_PERMISSION;
+    t->returned=arg;
+    pthread_mutex_lock(&lock); ++returns; pthread_mutex_unlock(&lock);
+    if (cur->context) {
+        cur->suspended=1;
+        switch_to(&cur->regs,&t->thread);
+    } else {
+        Regs discard;
+        switch_to(&discard,&t->thread);
+    }
+    /* Resumed by Run or Switch, maybe on another thread. */
+    fiber_begin();
+    t=self_thread();
+    if (on_run) *on_run=t->pass;
+    return 0;
+}
+static ABI int32_t fiber_get_self(Fiber **out) {
+    if (!out) return ERR_NULL;
+    FiberThread *t=self_thread();
+    if (!t->current) return ERR_PERMISSION;
+    *out=t->current; return 0;
+}
+static const RuntimeExport exports[]={
+    {"_sceFiberInitializeImpl",fiber_initialize}, {"sceFiberOptParamInitialize",fiber_opt_initialize},
+    {"sceFiberFinalize",fiber_finalize}, {"sceFiberRun",fiber_run},
+    {"sceFiberSwitch",fiber_switch_to}, {"sceFiberReturnToThread",fiber_return_to_thread},
+    {"sceFiberGetSelf",fiber_get_self},
+};
+uintptr_t runtime_fiber_resolve(const char *name) { return RUNTIME_LOOKUP(exports,name); }
+void runtime_fiber_report(void) {
+    pthread_mutex_lock(&lock);
+    printf("Runtime: fibers initialized=%zu, runs=%zu, switches=%zu, returns to thread=%zu\n",
+           initialized,runs,switches,returns);
+    pthread_mutex_unlock(&lock);
+}
