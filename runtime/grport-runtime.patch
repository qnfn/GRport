+static void ExpireIfTimedOut(const std::shared_ptr<ScoreRequestCtx>& req) {
+    {
+        std::lock_guard lock(req->mutex);
+        if (req->result.has_value() || std::chrono::steady_clock::now() < req->Deadline()) {
+            return;
+        }
+    }
+    if (NpHandler::GetInstance().CancelPendingRequest(req, ORBIS_HTTP_ERROR_TIMEOUT)) {
+        LOG_WARNING(Lib_NpScore, "request timed out after {} ms",
+                    std::chrono::duration_cast<std::chrono::milliseconds>(req->timeout).count());
+    }
+}
+
+static s32 WaitForResult(const std::shared_ptr<ScoreRequestCtx>& req) {
+    {
+        std::unique_lock lock(req->mutex);
+        if (req->cv.wait_until(lock, req->Deadline(), [&] { return req->result.has_value(); })) {
+            return *req->result;
+        }
+    }
+    ExpireIfTimedOut(req);
+    return req->Wait();
+}
+
+static void AbortRequest(const std::shared_ptr<ScoreRequestCtx>& req) {
+    if (!NpHandler::GetInstance().CancelPendingRequest(req, ORBIS_NP_COMMUNITY_ERROR_ABORTED)) {
+        req->SetResult(ORBIS_NP_COMMUNITY_ERROR_ABORTED);
+    }
+}
