+template <typename Pending, typename Ctx>
+static bool CancelPending(std::mutex& mutex, std::map<u64, Pending>& pending,
+                          const std::shared_ptr<Ctx>& req, s32 error_code) {
+    std::lock_guard lock(mutex);
+    const auto it =
+        std::ranges::find_if(pending, [&](const auto& p) { return p.second.req == req; });
+    if (it == pending.end()) {
+        return false;
+    }
+    pending.erase(it);
+    req->SetResult(error_code);
+    return true;
+}
+
+bool NpHandler::CancelPendingRequest(const std::shared_ptr<NpScore::ScoreRequestCtx>& req,
+                                     s32 error_code) {
+    return CancelPending(m_mutex_pending_score, m_pending_score, req, error_code);
+}
+
+bool NpHandler::CancelPendingRequest(const std::shared_ptr<NpTus::TusRequestCtx>& req,
+                                     s32 error_code) {
+    return CancelPending(m_mutex_pending_tus, m_pending_tus, req, error_code);
+}
