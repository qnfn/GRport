new file mode 100644
index 0000000..ec91a10
--- /dev/null
+++ b/tools/fsr4cap/stage_windows.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# tools/fsr4cap/stage_windows.sh <target dir>
+# Builds (once) and copies the Windows FSR 4.1.1 set-up tools into <target dir> (a release's
+# bin/fsr411): fsr4cap.exe, dxil-spirv with its library, SPIRV-Tools' spirv-as/spirv-dis, the
+# C++ runtime they share, the scripts, and the tools' licences. The launcher (dcport/fsr411.py)
+# runs them on the player's own AMD DLL. Nothing of AMD's is copied: the FidelityFX headers
+# fetched for building fsr4cap.exe are MIT, and AMD's DLLs are downloaded by the launcher.
+# Run from Git Bash or MSYS2; needs MSYS2 CLANG64 (clang, cmake, ninja, spirv-tools) and git.
+set -euo pipefail
+target=$(realpath -m -- "${1:?target dir}")
+cd -- "$(dirname -- "$0")/../.."
+work=$PWD/out/fsr4cap
+clang64=/c/msys64/clang64/bin
+mkdir -p "$work" "$target"
+in_clang64() { /c/msys64/usr/bin/env.exe MSYSTEM=CLANG64 CHERE_INVOKING=1 /usr/bin/bash -lc "$1"; }
+
+dx=$work/dxil-spirv
+if [[ ! -x $dx/build/dxil-spirv.exe ]]; then
+    rm -rf "$dx"
+    git clone -q https://github.com/HansKristian-Work/dxil-spirv.git "$dx"
+    git -C "$dx" checkout -q 7dc52786cdb1f53c54dd5c5c2698dff00ea5f0a3
+    git -C "$dx" submodule update -q --init --recursive
+    git -C "$dx" apply "$PWD/tools/fsr4cap/dxil-spirv-class-bindings.patch"
+    # libc++ wants <cstdlib> spelled out (third_party/cli_parser).
+    in_clang64 "cd '$dx' && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release '-DCMAKE_CXX_FLAGS=-include cstdlib' >/dev/null && ninja -C build dxil-spirv >/dev/null"
+fi
+
+sdk=$work/ffxsdk
+if [[ ! -f $sdk/Kits/FidelityFX/api/include/ffx_api.h ]]; then
+    rm -rf "$sdk"
+    git clone -q --filter=blob:none --sparse https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK.git "$sdk"
+    git -C "$sdk" checkout -q 60f4ea81909200d8542eca14dccb2628b763a9a3
+    MSYS_NO_PATHCONV=1 git -C "$(cygpath -w "$sdk")" sparse-checkout set --no-cone \
+        /Kits/FidelityFX/api/include/ /Kits/FidelityFX/upscalers/include/
+fi
+k=$sdk/Kits/FidelityFX
+if [[ ! -f $work/fsr4cap.exe || tools/fsr4cap/fsr4cap.c -nt $work/fsr4cap.exe || tools/fsr4cap/capture.c -nt $work/fsr4cap.exe ]]; then
+    in_clang64 "clang -std=c11 -O1 -I'$k/api/include' -I'$k/upscalers/include' tools/fsr4cap/fsr4cap.c tools/fsr4cap/capture.c tools/fsr4cap/rootsig.c -o '$work/fsr4cap.exe' -ld3d12 -ldxguid -static"
+fi
+
+cp "$work/fsr4cap.exe" "$dx/build/dxil-spirv.exe" "$dx/build/libdxil-spirv-c-shared.dll" "$target/"
+cp "$clang64/spirv-as.exe" "$clang64/spirv-dis.exe" "$clang64/libSPIRV-Tools.dll" "$clang64/libc++.dll" "$target/"
+cp tools/fsr4cap/extract.py tools/fsr4cap/name_bindings.py tools/fsr4cap/postpass_lds.py "$target/"
+mkdir -p "$target/licenses"
+cp "$dx/LICENSE.MIT" "$target/licenses/dxil-spirv-LICENSE.txt"
+cp /c/msys64/clang64/share/licenses/spirv-tools/LICENSE "$target/licenses/SPIRV-Tools-LICENSE.txt" 2>/dev/null || \
+    printf 'SPIRV-Tools: Apache License 2.0, https://github.com/KhronosGroup/SPIRV-Tools\n' > "$target/licenses/SPIRV-Tools-LICENSE.txt"
+cp /c/msys64/clang64/share/licenses/libc++/LICENSE.TXT "$target/licenses/libc++-LICENSE.txt" 2>/dev/null || \
+    printf 'libc++: Apache License 2.0 with LLVM Exceptions, https://llvm.org\n' > "$target/licenses/libc++-LICENSE.txt"
+printf 'fsr4cap.exe, extract.py, name_bindings.py, postpass_lds.py: GPL-2.0-or-later (bbport, DCport).\n' > "$target/licenses/README.txt"
+echo "FSR 4.1.1 tools in $target"
diff --git a/tools/import_audit.py b/tools/import_audit.py
new file mode 100644
index 0000000..ce2e7fc
--- /dev/null
+++ b/tools/import_audit.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Which of a prepared game's host imports the runtime implements, and which it does not.
+
+Usage: tools/import_audit.py <data dir with link.json> <aerolib.inl> [--all]
+
+Names come from shadPS4's aerolib.inl (NID -> name list). An import counts as implemented when
+the runtime's own C code exports that name (src/*.c tables) or the GPU layer registers its NID
+(LIB_FUNCTION in the shadPS4 libraries built into gpu/). Prints the missing ones by library.
+"""
+import collections
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+STUB = re.compile(r'STUB\("([^"]{11})",\s*([^)]+)\)')
+EXPORT = re.compile(r'\{\s*"([A-Za-z_][A-Za-z0-9_]*)"\s*,')
+LIBFN = re.compile(r'LIB_FUNCTION\(\s*"([^"]{11})"')
+
+
+def main(data: Path, aerolib: Path, show_all: bool) -> int:
+    names = dict(STUB.findall(aerolib.read_text(encoding="utf-8", errors="replace")))
+    exports = set()
+    for c in (ROOT / "src").glob("*.c"):
+        exports.update(EXPORT.findall(c.read_text(encoding="utf-8", errors="replace")))
+    hle = set()
+    for f in (ROOT / "gpu").rglob("*.cpp"):
+        if "third_party" in f.parts:
+            continue
+        hle.update(LIBFN.findall(f.read_text(encoding="utf-8", errors="replace")))
+    link = json.loads((data / "link.json").read_text(encoding="utf-8"))
+    hints = json.loads((data / "analysis.json").read_text(encoding="utf-8")).get("import_name_hints", {})
+    imports = link.get("unresolved_imports") or []
+    missing = collections.defaultdict(list)
+    done = 0
+    for item in imports:
+        scoped = item if isinstance(item, str) else item.get("name", "")
+        nid = scoped.split("#")[0]
+        name = names.get(nid) or hints.get(scoped) or "?"
+        if name in exports or nid in hle:
+            done += 1
+            continue
+        lib = item.get("library", "") if isinstance(item, dict) else ""
+        group = lib or (name[:name.find("_")] if name.startswith("sce") and "_" in name else
+                        re.match(r"(sce[A-Z][a-z0-9]+)", name).group(1) if re.match(r"sce[A-Z][a-z0-9]+", name)
+                        else "libc/other")
+        missing[group].append(f"{nid} {name}")
+    total = sum(len(v) for v in missing.values())
+    print(f"{len(imports)} host imports: {done} implemented, {total} missing")
+    for group, items in sorted(missing.items(), key=lambda kv: -len(kv[1])):
+        print(f"\n{group} ({len(items)})")
+        for line in sorted(items, key=lambda s: s.split(" ", 1)[1]):
+            print("  " + line)
+    return 0
+
+
+if __name__ == "__main__":
+    args = [a for a in sys.argv[1:] if not a.startswith("--")]
+    sys.exit(main(Path(args[0]), Path(args[1]), "--all" in sys.argv))
diff --git a/tools/nid_names.py b/tools/nid_names.py
new file mode 100644
index 0000000..7dc9edb
--- /dev/null
+++ b/tools/nid_names.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Add the NIDs a game imports to src/nid_names_all.inc for every function the runtime exports.
+
+A PS4 NID is the hash of the function's name, so the name of each export the runtime defines
+({"sceKernelFoo",foo} tables in src/*.c) gives its NID. Imports of a prepared game
+(boot-linked.bin) that hash to such a name, and are not in the table yet, are added; the file
+stays sorted by NID for bsearch.
+
+Usage: tools/nid_names.py <boot-linked.bin> [<boot-linked.bin> ...]
+"""
+import base64
+import hashlib
+import re
+import struct
+import sys
+from pathlib import Path
+
+SRC = Path(__file__).resolve().parent.parent / "src"
+TABLE = SRC / "nid_names_all.inc"
+SUFFIX = bytes.fromhex("518d64a635ded8c1e6b039b1c3e55230")
+EXPORT = re.compile(r'\{\s*"([A-Za-z_][A-Za-z0-9_]*)"\s*,')
+IMPORT = re.compile(rb'([A-Za-z0-9+\-]{11})#[A-Za-z0-9+\-]{1,3}#[A-Za-z0-9+\-]{1,3}')
+ENTRY = re.compile(r'^\{"([^"]{11})","([^"]+)"\},$')
+
+
+def nid(name: str) -> str:
+    digest = hashlib.sha1(name.encode() + SUFFIX).digest()[:8]
+    value = struct.unpack("<Q", digest)[0]
+    return base64.b64encode(struct.pack(">Q", value)).decode()[:11].replace("/", "-")
+
+
+def main(boots) -> int:
+    exports = set()
+    for c in SRC.glob("*.c"):
+        exports.update(EXPORT.findall(c.read_text(encoding="utf-8", errors="replace")))
+    by_nid = {nid(name): name for name in exports}
+    imported = set()
+    for boot in boots:
+        imported.update(m.decode() for m in IMPORT.findall(Path(boot).read_bytes()))
+    lines = TABLE.read_text(encoding="utf-8").splitlines()
+    head = [l for l in lines if not ENTRY.match(l)]
+    entries = dict(ENTRY.match(l).groups() for l in lines if ENTRY.match(l))
+    added = {n: by_nid[n] for n in imported if n in by_nid and n not in entries}
+    entries.update(added)
+    body = [f'{{"{k}","{v}"}},' for k, v in sorted(entries.items())]
+    TABLE.write_text("\n".join(head + body) + "\n", encoding="utf-8", newline="\n")
+    for k, v in sorted(added.items(), key=lambda kv: kv[1]):
+        print(f"added {k} {v}")
+    print(f"{len(added)} added; {len(entries)} names; "
+          f"{len([n for n in imported if n not in entries])} imported NIDs still unnamed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
